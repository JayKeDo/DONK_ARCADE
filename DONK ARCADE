local function FormatTime(seconds)
	seconds = math.max(0, seconds or 0)

	local minutes = math.floor(seconds / 60)
	local remaining = math.floor(seconds % 60)

	return string.format(
		"%02d:%02d",
		minutes,
		remaining
	)
end

