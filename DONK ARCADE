	--========================================================
	-- AUDIO LOOP
	--========================================================

	Bag:Add(
		RunService.RenderStepped:Connect(function()
			if returning then
				return
			end

			local now = os.clock()

			local dt =
				math.clamp(
					now - lastFrame,
					0,
					0.1
				)

			lastFrame = now

			local raw =
				ReadMicrophoneLevel()

			local smoothing =
				math.clamp(
					dt * 8,
					0,
					1
				)

			smoothLevel +=
				(raw - smoothLevel)
				* smoothing

			currentLevel =
				math.clamp(
					smoothLevel,
					0,
					100
				)

			if running then
				LevelNumber.Text =
					tostring(
						math.floor(
							currentLevel + 0.5
						)
					)

				local levelColor =
					GetLevelColor(
						currentLevel
					)

				LevelNumber.TextColor3 =
					levelColor

				LevelName.Text =
					GetLevelName(
						currentLevel
					)

				LevelName.TextColor3 =
					levelColor

				MeterStroke.Color =
					levelColor

				MeterAura.BackgroundColor3 =
					levelColor
			end

			UpdateCircleDisplay(
				currentLevel
			)

			-- Meter reaction.

			local normalized =
				currentLevel / 100

			local pulse =
				1
				+ normalized * 0.065

			MeterOuter.Size =
				UDim2.fromOffset(
					226 * pulse,
					226 * pulse
				)

			MeterAura.BackgroundTransparency =
				0.97
				- normalized * 0.08

			if running then
				local challenge =
					CHALLENGES[
						challengeIndex
					]

				-- KEEP IT DOWN:
				-- must remain >=80 briefly.

				if challenge == "KEEP IT DOWN" then
					if currentLevel >= 80 then
						dangerHold += dt
					else
						dangerHold =
							math.max(
								0,
								dangerHold - dt * 2
							)
					end

					if dangerHold >= 0.45 then
						Lose(
							"WHY: YOU STAYED IN THE DANGER RANGE"
						)

						return
					end

				-- STAY GREEN:
				-- orange/red for a short period fails.

				elseif challenge == "STAY GREEN" then
					if currentLevel >= 35 then
						dangerHold += dt
					else
						dangerHold =
							math.max(
								0,
								dangerHold - dt * 2.5
							)
					end

					if dangerHold >= 0.35 then
						Lose(
							"WHY: YOU LEFT THE GREEN RANGE"
						)

						return
					end

				-- NO RED:
				-- entering red briefly fails.

				elseif challenge == "NO RED" then
					if currentLevel >= 65 then
						dangerHold += dt
					else
						dangerHold = 0
					end

					if dangerHold >= 0.22 then
						Lose(
							"WHY: YOUR SOUND ENTERED THE RED RANGE"
						)

						return
					end

				-- NO SPIKES:
				-- raw sudden jumps / extreme peaks fail.

				elseif challenge == "NO SPIKES" then
					local suddenJump =
						raw - previousRaw

					if
						raw >= 90
						or (
							raw >= 65
							and suddenJump >= 28
						)
					then
						Lose(
							"WHY: YOUR MICROPHONE SPIKED"
						)

						return
					end
				end

				if roundEnd then
					local remaining =
						roundEnd
						- os.clock()

					if remaining <= 0 then
						Win()
						return
					end

					Timer.Text =
						string.format(
							"%02d",
							math.ceil(remaining)
						)

					if remaining <= 10 then
						Timer.TextColor3 =
							THEME.Red

					elseif remaining <= 20 then
						Timer.TextColor3 =
							THEME.Orange

					else
						Timer.TextColor3 =
							THEME.Text
					end
				end
			end

			previousRaw = raw
		end)
	)

