	local sliderDragging = false

	local function SetCustomSensitivityFromX(x)
		if
			running
			or sensitivityIndex ~= #SENSITIVITIES
		then
			return
		end

		local width =
			SliderBack.AbsoluteSize.X

		if width <= 0 then
			return
		end

		local relative =
			math.clamp(
				(
					x
					- SliderBack.AbsolutePosition.X
				)
					/ width,

				0,
				1
			)

		customSensitivity =
			math.floor(
				(
					50
					+ relative * 200
				)
					/ 5
					+ 0.5
			)
				* 5

		UpdateSensitivityUI()
	end

	Bag:Add(
		SliderBack.InputBegan:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				sliderDragging = true

				SetCustomSensitivityFromX(
					input.Position.X
				)
			end
		end)
	)

	Bag:Add(
		UserInputService.InputChanged:Connect(function(input)
			if not sliderDragging then
				return
			end

			if
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			then
				SetCustomSensitivityFromX(
					input.Position.X
				)
			end
		end)
	)

