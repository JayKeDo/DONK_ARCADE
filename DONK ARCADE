	local returning = false

	local function ReturnToHub()

		if returning then
			return
		end

		returning = true

		audioWatcherRunning =
			false

		running = false

		roundEnd = nil

		pcall(function()

			if wire then
				wire:Destroy()
			end

			if analyzer then
				analyzer:Destroy()
			end

			if SoundFolder then
				SoundFolder:Destroy()
			end
		end)

		Tween(
