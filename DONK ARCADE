            return Workspace:GetPartBoundsInRadius(root.Position,SCAN_DISTANCE,params)
        end)
        if ok and type(result)=="table" then parts=result else
            for _,d in ipairs(Workspace:GetDescendants()) do
                if d:IsA("BasePart") and (d.Position-root.Position).Magnitude<=SCAN_DISTANCE then table.insert(parts,d) end
            end
        end
        for _,p in ipairs(parts) do
            if p:IsA("BasePart") and p.Transparency < 0.95 and p.CanCollide then
                local n=nearestFamily(p.Color); counts[n]=(counts[n] or 0)+1
            end
        end
        local valid={}
        for _,n in ipairs(familyOrder) do if counts[n]>=MIN_FAMILY_PARTS then table.insert(valid,{Name=n,Count=counts[n]}) end end
        scanStatus.Text="MAP DETECTION\n"..tostring(#valid).." usable color families"
