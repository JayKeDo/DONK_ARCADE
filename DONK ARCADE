local function refreshCanvas()
    task.defer(function()
        GameScroll.CanvasSize = UDim2.fromOffset(0, Grid.AbsoluteContentSize.Y + 12)
    end)
end
Grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refreshCanvas)
