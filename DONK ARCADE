			if remaining <= 10 then

				TimerLabel.TextColor3 =
					THEME.Red

				TimerLabel.BackgroundColor3 =
					Color3.fromRGB(
						50,
						18,
						30
					)

			elseif remaining <= 20 then

				TimerLabel.TextColor3 =
					THEME.Yellow

				TimerLabel.BackgroundColor3 =
					Color3.fromRGB(
						45,
						38,
						18
					)

			else

				TimerLabel.TextColor3 =
					THEME.Cyan

				TimerLabel.BackgroundColor3 =
					THEME.Panel2
			end
