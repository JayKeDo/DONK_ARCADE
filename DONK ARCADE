	--========================================================
	-- AUDIO INPUT
	--========================================================

	local function FindAudioInput()

		local player =
			GetLocalPlayer()

		if not player then
			return nil
		end

		local input

		pcall(function()

			input =
				player:FindFirstChild(
					"AudioDeviceInput"
				)

			if not input then

				input =
					player:FindFirstChildWhichIsA(
						"AudioDeviceInput"
					)
			end
		end)

		return input
	end

	local function SetupAudioAnalyzer()

		pcall(function()

			if wire then
				wire:Destroy()
			end

			if analyzer then
				analyzer:Destroy()
			end
		end)

		wire = nil
		analyzer = nil
		audioInput = nil

		audioInput =
			FindAudioInput()

		if not audioInput then

			microphoneReady =
				false

			MicStatus.Text =
				"● MICROPHONE: NOT AVAILABLE"

			MicStatus.TextColor3 =
				THEME.Red

			return false
		end

		local success =
			pcall(
				function()

					analyzer =
						Instance.new(
							"AudioAnalyzer"
						)

					analyzer.Name =
						"LowerToneAnalyzer"

					analyzer.Parent =
						GameGui

					analyzer.SpectrumEnabled =
						false

					wire =
						Instance.new(
							"Wire"
						)

					wire.Name =
						"LowerToneMicWire"

					wire.SourceInstance =
						audioInput

					wire.SourceName =
						"Output"

					wire.TargetInstance =
						analyzer

					wire.TargetName =
						"Input"

					wire.Parent =
						analyzer
				end
			)

		if not success
			or
			not analyzer
			or
			not wire then

			microphoneReady =
				false

			MicStatus.Text =
				"● MICROPHONE: SETUP FAILED"

			MicStatus.TextColor3 =
				THEME.Red

			return false
		end

		microphoneReady =
			true

		MicStatus.Text =
			"● MICROPHONE: READY"

		MicStatus.TextColor3 =
			THEME.Green

		return true
	end

