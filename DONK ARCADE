	local function ClearMulti()
		for _, slot in ipairs(DangerSlots) do
			slot.Frame.Visible = false
			slot.Dot.BackgroundColor3 = THEME.Panel4
			slot.Label.Text = "—"
		end
	end

	local function SetMulti(families)
		ClearMulti()

		for index, family in ipairs(families) do
			local slot = DangerSlots[index]

			if slot then
				slot.Frame.Visible = true

				slot.Dot.BackgroundColor3 =
					FAMILY_COLORS[family]
					or THEME.Panel4

				slot.Label.Text = family
			end
		end
	end

