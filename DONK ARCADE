	--========================================================
	-- FAILURE CREATION
	--========================================================

	local function TriggerFailure()

		local available = {}

		for _,name in ipairs(
			systemOrder
		) do

			if not systems[name].Active then

				table.insert(
					available,
					name
				)
			end
		end

		if #available == 0 then
			return
		end

		local name =
			available[
				math.random(
					1,
					#available
				)
			]

		local state =
			systems[name]

		state.Active =
			true

		state.Severity =
			math.random(
				75,
				130
			)
			/
			100

		state.Decay =
			(
				4.2
				+
				wave
				*
				0.55
			)
			*
			state.Severity

		state.Started =
			os.clock()

		failures +=
			1

		UpdateSystemButtons()
	end

	--========================================================
	-- REPAIR
	--========================================================

	local function RepairSystem(
		name,
		bonus
	)

		local state =
			systems[name]

		if not state.Active then
			return
		end

		state.Active =
			false

		state.Health =
			math.min(
				100,
				state.Health
				+
				20
				+
				(bonus or 0)
			)

		combo += 1

		bestCombo =
			math.max(
				bestCombo,
				combo
			)

		score +=
			100
			+
			wave
			*
			20
			+
			combo
			*
			8

		ScoreLabel.Text =
			tostring(
				score
			)

		ComboLabel.Text =
			"x"
			..
			tostring(
				combo
			)

		UpdateSystemButtons()

		ClearChallenge()

		selectedSystem =
			nil

		WorkTitle.Text =
			"SYSTEM RESTORED"

		WorkTitle.TextColor3 =
			THEME.Green

		WorkSub.Text =
			name
			..
			" stabilized. Select the next failing system."

		task.delay(
			0.75,
			function()

				if not running then
					return
				end

				WorkTitle.Text =
					"LOCKDOWN CONTROL CENTER"

				WorkTitle.TextColor3 =
					THEME.Text
			end
		)
	end

