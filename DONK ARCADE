	RunService.RenderStepped:Connect(
		function()

			if not running then
				return
			end

			if not
				(
					MODES[
						currentModeIndex
					]
					==
					"Timed"
					or
					MODES[
						currentModeIndex
					]
					==
					"Hard"
				) then

				return
			end

			if not roundEnd then
				return
			end

			local remaining =
				roundEnd -
				os.clock()

			if remaining <= 0 then

				WinRound()

				return
			end

			local seconds =
				math.ceil(
					remaining
				)

			TimerLabel.Text =
				string.format(
					"%02d",
					seconds
				)

			if remaining <= 10 then

				TimerLabel.TextColor3 =
					THEME.Red

			elseif remaining <= 20 then

				TimerLabel.TextColor3 =
					THEME.Orange

			else

				TimerLabel.TextColor3 =
					THEME.Cyan
			end
		end
	)

