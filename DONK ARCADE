	--========================================================
	-- PROJECTILE
	--========================================================

	local function PointHitsBox(
		position,
		box
	)

		return
			position.X >=
			box.X

			and
			position.X <=
			box.X
			+
			box.W

			and
			position.Y >=
			box.Y

			and
			position.Y <=
			box.Y
			+
			box.H
	end

	local function FireShot()

		if not running
			or
			projectileAlive then

			return
		end

		if shots >=
			maxShots then

			running =
				false

			Start.Text =
				"RETRY STAGE"

			Message.Text =
				"OUT OF SHOTS"

			Message.TextColor3 =
				THEME.Red

			return
		end

		shots +=
			1

		ShotLabel.Text =
			"SHOTS "
			..
			tostring(
				shots
			)
			..
			"/"
			..
			tostring(
				maxShots
			)

		projectileAlive =
			true

		local projectile =
			Create(
				"Frame",
				{
					Size =
						UDim2.fromOffset(
							12,
							12
						),

					BackgroundColor3 =
						THEME.Orange,

					BorderSizePixel =
						0,

					ZIndex = 135
				},
				Arena
			)

		Corner(
			projectile,
			6
		)

		local position =
			Vector2.new(
				ARENA_WIDTH
				/
				2,

				ARENA_HEIGHT
				-
				65
			)

		local radians =
			math.rad(
				aimAngle
			)

		local velocity =
			Vector2.new(
				math.cos(
					radians
				),

				math.sin(
					radians
				)
			)
			*
			330

		local bounces =
			0

		task.spawn(
			function()

				local last =
					os.clock()

				local lifetime =
					0

				while projectileAlive
					and
					projectile.Parent do

					local now =
						os.clock()

					local dt =
						math.min(
							now
							-
							last,
							0.035
						)

					last =
						now

					lifetime +=
						dt

					position +=
						velocity
						*
						dt

					if position.X <= 0 then

						position =
							Vector2.new(
								0,
								position.Y
							)

						velocity =
							Vector2.new(
								math.abs(
									velocity.X
								),
								velocity.Y
							)

						bounces +=
							1

					elseif position.X >=
						ARENA_WIDTH
						-
						12 then

						position =
							Vector2.new(
								ARENA_WIDTH
								-
								12,
								position.Y
							)

						velocity =
							Vector2.new(
								-math.abs(
									velocity.X
								),
								velocity.Y
							)

						bounces +=
							1
					end

					if position.Y <= 0 then

						position =
							Vector2.new(
								position.X,
								0
							)

						velocity =
							Vector2.new(
								velocity.X,
								math.abs(
									velocity.Y
								)
							)

						bounces +=
							1

					elseif position.Y >=
						ARENA_HEIGHT
						-
						12 then

						projectileAlive =
							false

						break
					end

					for _,wall in ipairs(
						Walls
					) do

						if PointHitsBox(
							position,
							wall
						) then

							local centerX =
								wall.X
								+
								wall.W
								/
								2

							local centerY =
								wall.Y
								+
								wall.H
								/
								2

							local dx =
								math.abs(
									position.X
									-
									centerX
								)

							local dy =
								math.abs(
									position.Y
									-
									centerY
								)

							if dx /
								math.max(
									1,
									wall.W
								)
								>
								dy /
								math.max(
									1,
									wall.H
								) then

								velocity =
									Vector2.new(
										-velocity.X,
										velocity.Y
									)

							else

								velocity =
									Vector2.new(
										velocity.X,
										-velocity.Y
									)
							end

							bounces +=
								1

							position +=
								velocity.Unit
								*
								8

							break
						end
					end

					for _,target in ipairs(
						Targets
					) do

						if target.Alive
							and
							PointHitsBox(
								position,
								target
							) then

							target.Alive =
								false

							SafeDestroy(
								target.Object
							)

							targetsRemaining -=
								1

							score +=
								200
								+
								bounces
								*
								45

							ScoreLabel.Text =
								"SCORE • "
								..
								tostring(
									score
								)

							TargetsLabel.Text =
								"TARGETS • "
								..
								tostring(
									targetsRemaining
								)

							if targetsRemaining <= 0 then

								projectileAlive =
									false

								stage +=
									1

								score +=
									math.max(
										0,
										(
											maxShots
											-
											shots
										)
										*
										60
									)

								task.wait(
									0.45
								)

								LoadStage()

								break
							end
						end
					end

					projectile.Position =
						UDim2.fromOffset(
							position.X,
							position.Y
						)

					if lifetime >= 9
						or
						bounces >= 15 then

						projectileAlive =
							false

						break
					end

					RunService.RenderStepped:Wait()
				end

				SafeDestroy(
					projectile
				)

				projectileAlive =
					false

				if running
					and
					shots >=
					maxShots
					and
					targetsRemaining > 0 then

					running =
						false

					Start.Text =
						"RETRY STAGE"

					Message.Text =
						"OUT OF SHOTS"

					Message.TextColor3 =
						THEME.Red
				end
			end
		)
	end

