	--========================================================
	-- AUDIO SETUP
	--========================================================

	local function FindAudioInput()

		local player =
			GetLocalPlayer()

		if not player then
			return nil
		end

		local input

		pcall(function()

			input =
				player:FindFirstChild(
					"AudioDeviceInput"
				)

			if not input then

				input =
					player:FindFirstChildWhichIsA(
						"AudioDeviceInput"
					)
			end
		end)

		return input
	end

	local function SetupAudioAnalyzer()

		-- Clean old audio objects.

		pcall(function()

			if wire then
				wire:Destroy()
			end

			if analyzer then
				analyzer:Destroy()
			end
		end)

		wire = nil
		analyzer = nil
		audioInput = nil

		audioInput =
			FindAudioInput()

		if not audioInput then

			MicStatus.Text =
				"● MICROPHONE: NOT AVAILABLE"

			MicStatus.TextColor3 =
				THEME.Red

			return false
		end

		local success =
			pcall(
				function()

					analyzer =
						Instance.new(
							"AudioAnalyzer"
						)

					analyzer.Name =
						"LowerToneAnalyzer"

					analyzer.Parent =
						GameGui

					analyzer.SpectrumEnabled =
						false

					wire =
						Instance.new(
							"Wire"
						)

					wire.Name =
						"LowerToneMicWire"

					wire.SourceInstance =
						audioInput

					wire.SourceName =
						"Output"

					wire.TargetInstance =
						analyzer

					wire.TargetName =
						"Input"

					wire.Parent =
						analyzer
				end
			)

		if not success
			or
			not analyzer
			or
			not wire then

			MicStatus.Text =
				"● MICROPHONE: SETUP FAILED"

			MicStatus.TextColor3 =
				THEME.Red

			microphoneReady =
				false

			return false
		end

		microphoneReady =
			true

		MicStatus.Text =
			"● MICROPHONE: READY"

		MicStatus.TextColor3 =
			THEME.Green

		return true
	end

	--========================================================
	-- AUDIO LEVEL CONVERSION
	--========================================================

	local function ReadMicrophoneLevel()

		if not microphoneReady
			or
			not analyzer then

			return 0
		end

		local rms = 0
		local peak = 0

		pcall(function()

			rms =
				tonumber(
					analyzer.RmsLevel
				)
				or
				0

			peak =
				tonumber(
					analyzer.PeakLevel
				)
				or
				0
		end)

		if rms < 0 then
			rms = 0
		end

		if peak < 0 then
			peak = 0
		end

		-- Roblox analyzer measurements are audio
		-- amplitude measurements. Square-rooting the
		-- power-style value gives us a more useful
		-- visual amplitude scale.

		local rmsAmplitude =
			math.sqrt(
				math.clamp(
					rms,
					0,
					1
				)
			)

		local peakAmplitude =
			math.sqrt(
				math.clamp(
					peak,
					0,
					1
				)
			)

		-- RMS controls the main meter.
		-- A small amount of peak data catches
		-- sharper loud moments.

		local mixed =
			(
				rmsAmplitude *
				0.78
			)
			+
			(
				peakAmplitude *
				0.22
			)

		local sensitivity =
			SENSITIVITIES[
				sensitivityIndex
			]

		local value =
			mixed *
			100 *
			sensitivity.Multiplier

		return math.clamp(
			value,
			0,
			100
		)
	end

