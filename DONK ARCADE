	--========================================================
	-- DANGER DETECTOR
	--========================================================

	local function StandingOnDangerFamily()

		local character =
			GetCharacter()

		if not character then
			return false
		end

		local root =
			character:FindFirstChild(
				"HumanoidRootPart"
			)

		if not root then
			return false
		end

		local overlapParams =
			OverlapParams.new()

		overlapParams.FilterType =
			Enum.RaycastFilterType.Exclude

		overlapParams.FilterDescendantsInstances =
			{
				character
			}

		local parts =
			workspace:GetPartBoundsInBox(

				CFrame.new(
					root.Position.X,
					root.Position.Y - 3,
					root.Position.Z
				),

				Vector3.new(
					3.5,
					1.2,
					3.5
				),

				overlapParams
			)

		for _,part in ipairs(
			parts
		) do

			if part:IsA("BasePart") then

				local family =
					GetColorFamily(
						part.Color
					)

				if dangerFamilies[
					family
				] then

					return true
				end
			end
		end

		return false
	end

	--========================================================
	-- ADVANCED AFK DETECTOR
	--========================================================

	local function UpdateAFK()

		if not running then
			return
		end

		local root =
			GetRoot()

		if not root then

			-- Do not count missing characters
			-- as AFK and do not throw errors.

			afkAnchorPosition =
				nil

			afkTimerStart =
				nil

			AFKWarning.Text =
				""

			return
		end

		local currentPosition =
			Vector3.new(
				root.Position.X,
				0,
				root.Position.Z
			)

		--====================================================
		-- CREATE ANCHOR
		--====================================================

		if not afkAnchorPosition then

			afkAnchorPosition =
				currentPosition

			afkTimerStart =
				os.clock()

			return
		end

		--====================================================
		-- DISTANCE FROM ORIGINAL CAMP ZONE
		--====================================================

		local distanceFromAnchor =
			(
				currentPosition -
				afkAnchorPosition
			).Magnitude

		--====================================================
		-- IMPORTANT:
		--
		-- We DO NOT reset the timer simply because the
		-- player moved 1 stud, 2 studs, 3 studs, etc.
		--
		-- They must leave the entire camp radius.
		--====================================================

		if distanceFromAnchor >=
			AFK_CAMP_RADIUS then

			-- Meaningful movement has happened.
			-- Create a NEW camp zone.

			afkAnchorPosition =
				currentPosition

			afkTimerStart =
				os.clock()

			afkWarningActive =
				false

			AFKWarning.Text =
				""

			return
		end

		--====================================================
		-- PLAYER IS STILL INSIDE CAMP ZONE
		--====================================================

		local elapsed =
			os.clock() -
			afkTimerStart

		local remaining =
			AFK_LIMIT -
			elapsed

		--====================================================
		-- WARNING
		--====================================================

		if elapsed >=
			AFK_WARNING_START
			and remaining > 0 then

			afkWarningActive =
				true

			AFKWarning.Text =
				"⚠ LEAVE THE AREA! AUTO-LOSS IN "
				..
				string.format(
					"%.1f",
					remaining
				)
				..
				" SECONDS"

			AFKWarning.TextColor3 =
				THEME.Yellow

			-- Small visual pulse
			-- on the warning text.

			local pulse =
				(
					math.sin(
						os.clock() * 8
					)
					+ 1
				)
				/ 2

			AFKWarning.TextTransparency =
				pulse * 0.15

		else

			afkWarningActive =
				false

			AFKWarning.Text =
				""

			AFKWarning.TextTransparency =
				0
		end

		--====================================================
		-- AUTO LOSS
		--====================================================

		if remaining <= 0 then

			AFKLoss()
		end
	end

