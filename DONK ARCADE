            local total=0; for _,v in ipairs(pool) do total+=v.Count end
            local r=math.random()*total; local acc=0; local pick=1
            for i,v in ipairs(pool) do acc+=v.Count; if r<=acc then pick=i; break end end
            table.insert(result,pool[pick].Name); table.remove(pool,pick)
        end
        return result
    end

