	--========================================================
	-- AUDIO RENDER LOOP
	--========================================================

	RunService.RenderStepped:Connect(
		function()

			local now =
				os.clock()

			local dt =
				math.clamp(
					now -
					lastFrame,
					0,
					0.1
				)

			lastFrame =
				now

			local raw =
				ReadMicrophoneLevel()

			-- Smooth microphone level.

			local smoothing =
				math.clamp(
					dt *
					8,
					0,
					1
				)

			smoothLevel =
				smoothLevel
				+
				(
					raw -
					smoothLevel
				)
				*
				smoothing

			currentLevel =
				math.clamp(
					smoothLevel,
					0,
					100
				)

			LevelNumber.Text =
				tostring(
					math.floor(
						currentLevel
						+
						0.5
					)
				)

			local levelName =
				GetLevelName(
					currentLevel
				)

			local levelColor =
				GetLevelColor(
					currentLevel
				)

			LevelName.Text =
				levelName

			LevelNumber.TextColor3 =
				levelColor

			LevelName.TextColor3 =
				levelColor

			UpdateCircleDisplay(
				currentLevel
			)

			--================================================
			-- MAIN METER REACTION
			--================================================

			local normalized =
				currentLevel /
				100

			local pulse =
				1
				+
				normalized *
				0.09

			MeterOuter.Size =
				UDim2.fromOffset(
					225 *
					pulse,

					225 *
					pulse
				)

			MeterOuter.Position =
				UDim2.new(
					0.5,

					-112 *
					pulse,

					0,

					106 -
					(
						112 *
						(
							pulse -
							1
						)
					)
				)

			if running then

				local challenge =
					CHALLENGES[
						challengeIndex
					]

				--================================================
				-- KEEP IT DOWN
				--================================================

				if challenge ==
					"KEEP IT DOWN"
					or
					challenge ==
					"NO RED" then

					if currentLevel >=
						78 then

						Lose(
							"LEVEL"
						)

						return
					end

				--================================================
				-- STAY GREEN
				--================================================

				elseif challenge ==
					"STAY GREEN" then

					if currentLevel >=
						35 then

						Lose(
							"LEVEL"
						)

						return
					end

				--================================================
				-- NO SPIKES
				--================================================

				elseif challenge ==
					"NO SPIKES" then

					if currentLevel >=
						80 then

						spikeCount +=
							dt

					else

						spikeCount =
							math.max(
								0,
								spikeCount -
								dt *
								0.5
							)
					end

					if spikeCount >=
						3 then

						Lose(
							"SPIKE"
						)

						return
					end
				end

				--================================================
				-- TIMER
				--================================================

				if roundEnd then

					local remaining =
						roundEnd -
						os.clock()

					if remaining <= 0 then

						Win()

						return
					end

					Timer.Text =
						string.format(
							"%02d",
							math.ceil(
								remaining
							)
						)

					if remaining <=
						10 then

						Timer.TextColor3 =
							THEME.Red

					elseif remaining <=
						20 then

						Timer.TextColor3 =
							THEME.Orange

					else

						Timer.TextColor3 =
							THEME.Text
					end
				end
			end
		end
	)

