		if running or selecting then
			Invalidate()
		end

		currentModeIndex -= 1

		if currentModeIndex < 1 then
			currentModeIndex = #MODES
		end

		optionIndex = 1

		UpdateUI()
	end)

	ModeRight.MouseButton1Click:Connect(function()
		if running or selecting then
			Invalidate()
		end

		currentModeIndex += 1

		if currentModeIndex > #MODES then
			currentModeIndex = 1
		end

		optionIndex = 1

		UpdateUI()
	end)

	local function ChangeOption(direction)
		local mode = MODES[currentModeIndex]

		if mode == "Endless" then
			return
		end

		if running or selecting then
			Invalidate()
		end

		optionIndex += direction

		local options =
			mode == "Timed"
				and TIMED_OPTIONS
				or HARD_OPTIONS

		if optionIndex < 1 then
			optionIndex = #options

		elseif optionIndex > #options then
			optionIndex = 1
		end

		UpdateUI()
	end

	OptionLeft.MouseButton1Click:Connect(function()
		ChangeOption(-1)
	end)

	OptionRight.MouseButton1Click:Connect(function()
		ChangeOption(1)
	end)

	StartButton.MouseButton1Click:Connect(function()
		if running or selecting then
			Invalidate()

			Status.Text = "ROUND STOPPED"
			Status.TextColor3 = THEME.Yellow

			AFKWarning.Text = "Round manually stopped."
			AFKWarning.TextColor3 = THEME.Yellow

			return
		end

		task.spawn(StartRound)
	end)

