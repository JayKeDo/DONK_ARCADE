	-- COLOR LOGIC
	--========================================================

	local function GetColorFamily(color)
		local h, s, v = color:ToHSV()

		if v < 0.16 then
			return "BLACK"
		end

		if s < 0.10 and v > 0.82 then
			return "WHITE"
		end

		if s < 0.18 then
			return "GRAY"
		end

		if h >= 0.04 and h <= 0.13 and v < 0.60 then
			return "BROWN"
		end

		if h < 0.035 or h >= 0.96 then
			return "RED"
		end

		if h < 0.10 then
			return "ORANGE"
		end

		if h < 0.18 then
			return "YELLOW"
		end

		if h < 0.43 then
			return "GREEN"
		end

		if h < 0.53 then
			return "CYAN"
		end

		if h < 0.68 then
			return "BLUE"
		end

		if h < 0.82 then
			return "PURPLE"
		end

		if h < 0.96 then
			return "PINK"
		end

		return "GRAY"
	end

	local function ScanColorFamilies()
		local counts = {}
		local representatives = {}

		local root = GetRoot()

		local origin =
			root
				and root.Position
				or Vector3.zero

		local parts = nil

		pcall(function()
			local params = OverlapParams.new()

			params.FilterType = Enum.RaycastFilterType.Exclude

			if GetCharacter() then
				params.FilterDescendantsInstances = {
					GetCharacter()
				}
			end

			parts = Workspace:GetPartBoundsInRadius(
				origin,
				SCAN_DISTANCE,
				params
			)
		end)

		if not parts then
			parts = {}

			for _, object in ipairs(Workspace:GetDescendants()) do
				if object:IsA("BasePart") then
					local valid = false

					pcall(function()
						valid =
							(object.Position - origin).Magnitude
							<= SCAN_DISTANCE
					end)

					if valid then
						table.insert(parts, object)
					end
				end
			end
		end

		for _, part in ipairs(parts) do
			if part:IsA("BasePart") then
				local family = GetColorFamily(part.Color)

				counts[family] =
					(counts[family] or 0)
					+ 1

				if not representatives[family] then
					representatives[family] = part.Color
				end
			end
		end

		local candidates = {}

		for family, count in pairs(counts) do
			if count >= MIN_FAMILY_PARTS then
				table.insert(candidates, {
					family = family,
					count = count,
					color = representatives[family]
				})
			end
		end

		table.sort(candidates, function(a, b)
			return a.count > b.count
		end)

		return candidates, #parts
	end

	local function ChooseTargetFamilies(candidates, amount)
		local result = {}
		local available = {}

		for _, entry in ipairs(candidates) do
			table.insert(available, entry)
		end

		amount = math.min(amount, #available)

		while #result < amount and #available > 0 do
			local totalWeight = 0

			for _, entry in ipairs(available) do
				totalWeight += math.clamp(
					entry.count,
					1,
					10000
				)
			end

			local pick = math.random() * totalWeight
			local chosenIndex = 1

			for index, entry in ipairs(available) do
				pick -= math.clamp(
					entry.count,
					1,
					10000
				)

				if pick <= 0 then
					chosenIndex = index
					break
				end
			end

			local chosen = table.remove(
				available,
				chosenIndex
			)

			table.insert(
				result,
				chosen.family
			)
		end

		return result
	end

