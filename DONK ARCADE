		table.clear(
			input
		)
	end

	local function UpdateIntegrity()

		IntegrityLabel.Text =
			"INTEGRITY • "
			..
			tostring(
				math.floor(
					integrity
				)
			)
			..
			"%"

		if integrity >= 65 then

			IntegrityLabel.TextColor3 =
				THEME.Green

		elseif integrity >= 35 then

			IntegrityLabel.TextColor3 =
				THEME.Orange

		else

			IntegrityLabel.TextColor3 =
				THEME.Red
		end
	end

	local function GenerateStage()

		ClearNodes()

		input =
			{}

		mistakes =
			0

		nodeCount =
			math.clamp(
				4
				+
				math.floor(
					stage
					*
					0.75
				),
				5,
				12
			)

		local routeLength =
			math.clamp(
				3
				+
				stage,
				4,
				10
			)

		for i = 1,nodeCount do

			local button =
				Create(
					"TextButton",
					{
						Size =
							UDim2.fromOffset(
								58,
								58
							),

						Position =
							UDim2.fromOffset(
								math.random(
									25,
									525
								),

								math.random(
									30,
									350
								)
							),

						BackgroundColor3 =
							THEME.Panel3,

						Text =
							tostring(
								i
							),

						TextColor3 =
							THEME.Text,

						TextSize = 12,

						Font =
							Enum.Font.GothamBlack,

						AutoButtonColor =
							false,

						ZIndex = 126
					},
					Network
				)

			Corner(
				button,
				29
			)

			Stroke(
				button,
				THEME.Purple,
				1,
				0.55
			)

			NodeButtons[i] =
				button
		end

		local available = {}

		for i = 1,nodeCount do

			table.insert(
				available,
				i
			)
		end

		for i = 1,routeLength do

			if #available == 0 then
				break
			end

			local pick =
				math.random(
					1,
					#available
				)

			table.insert(
				sequence,
				table.remove(
					available,
					pick
				)
			)
		end

		Progress.Text =
			"0 / "
			..
			tostring(
				#sequence
			)

		StageLabel.Text =
			"STAGE "
			..
			tostring(
				stage
			)

		MistakeLabel.Text =
			"ERRORS • 0"

		Message.Text =
			"Signal preview incoming..."

		previewing =
			true

		task.spawn(
			function()

				task.wait(
					0.7
				)

				for index,nodeIndex in ipairs(
					sequence
				) do

					if not running then
						return
					end

					local button =
						NodeButtons[
							nodeIndex
						]

					button.BackgroundColor3 =
						THEME.Purple

					button.TextColor3 =
						Color3.new(
							1,
							1,
							1
						)

					button.Text =
						tostring(
							index
						)

					task.wait(
						math.max(
							0.24,
							0.5
							-
							stage
							*
							0.02
						)
					)

					button.BackgroundColor3 =
						THEME.Panel3

					button.TextColor3 =
						THEME.Text

					button.Text =
						tostring(
							nodeIndex
						)

					task.wait(
						0.13
					)
				end

				previewing =
					false

				Message.Text =
					"Reconstruct the route."
			end
		)

		for index,button in ipairs(
			NodeButtons
		) do

			button.MouseButton1Click:Connect(
				function()

					if not running
						or
						previewing then

						return
					end

					local nextIndex =
						#input
						+
						1

					if sequence[
						nextIndex
					]
					==
					index then

						table.insert(
							input,
							index
						)

						button.BackgroundColor3 =
							THEME.Green

						Progress.Text =
							tostring(
								#input
							)
							..
							" / "
							..
							tostring(
								#sequence
							)

						score +=
							25
							+
							stage
							*
							4

						ScoreLabel.Text =
							"SCORE • "
							..
							tostring(
								score
							)

						if #input >=
							#sequence then

							score +=
								300
								+
								stage
								*
								75

							integrity =
								math.min(
									100,
									integrity
									+
									7
								)

							UpdateIntegrity()

							Message.Text =
								"NETWORK RESTORED"

							Message.TextColor3 =
								THEME.Green

							stage +=
								1

							task.delay(
								1,
								function()

									if running then

										Message.TextColor3 =
											THEME.Cyan

										GenerateStage()
									end
								end
							)
						end

					else

						mistakes +=
							1

						MistakeLabel.Text =
							"ERRORS • "
							..
							tostring(
								mistakes
							)

						integrity -=
							12
							+
							stage
							*
							1.2

						score =
							math.max(
								0,
								score
								-
								40
							)

						ScoreLabel.Text =
							"SCORE • "
							..
							tostring(
								score
							)

						UpdateIntegrity()

						button.BackgroundColor3 =
							THEME.Red

						task.delay(
							0.28,
							function()

								if button
									and
									button.Parent then

									button.BackgroundColor3 =
										THEME.Panel3
								end
							end
						)

						input =
							{}

						Progress.Text =
							"0 / "
							..
							tostring(
								#sequence
							)

						Message.Text =
							"CORRUPTED ROUTE • START AGAIN"

						Message.TextColor3 =
							THEME.Red

						for _,node in ipairs(
							NodeButtons
						) do

							node.BackgroundColor3 =
								THEME.Panel3
						end

						if integrity <= 0 then

							integrity =
								0

							UpdateIntegrity()

							running =
								false

							Start.Text =
								"RESTART NETWORK"

							Message.Text =
								"NETWORK COLLAPSED\nFinal score: "
								..
								tostring(
									score
								)

							return
						end
					end
				end
			)
		end
	end

	Start.MouseButton1Click:Connect(
		function()

			if running then
				return
			end

			running =
				true

			stage =
				1

			score =
				0

			integrity =
				100

			mistakes =
