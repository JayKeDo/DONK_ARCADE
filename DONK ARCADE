local function CreateSettingToggle(title, description, y, settingKey)
	Create(
		"TextLabel",

		{
			Size = UDim2.new(1, -120, 0, 20),
			Position = UDim2.fromOffset(18, y),
			BackgroundTransparency = 1,
			Text = title,
			TextColor3 = THEME.Text,
			TextSize = 11,
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 37
		},

		SettingsPanel
	)

	Create(
		"TextLabel",

		{
			Size = UDim2.new(1, -120, 0, 32),
			Position = UDim2.fromOffset(18, y + 21),
			BackgroundTransparency = 1,
			Text = description,
			TextColor3 = THEME.SubText,
			TextSize = 8,
			Font = Enum.Font.GothamMedium,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = 37
		},

		SettingsPanel
	)

	local toggle = Create(
		"TextButton",

		{
			Size = UDim2.fromOffset(58, 28),
			Position = UDim2.new(1, -79, 0, y + 10),
			BackgroundColor3 = Settings[settingKey] and THEME.Cyan or THEME.Panel4,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 38
		},

		SettingsPanel
	)

	Corner(toggle, 999)

	local knob = Create(
		"Frame",

		{
			Size = UDim2.fromOffset(20, 20),

			Position =
				Settings[settingKey]
				and UDim2.new(1, -24, 0.5, -10)
				or UDim2.new(0, 4, 0.5, -10),

			BackgroundColor3 = Color3.fromRGB(245, 248, 255),
			BorderSizePixel = 0,
			ZIndex = 39
		},

		toggle
	)

	Corner(knob, 999)

	toggle.MouseButton1Click:Connect(function()
		Settings[settingKey] = not Settings[settingKey]

		local enabled = Settings[settingKey]

		Tween(
			toggle,
			0.18,
			{
				BackgroundColor3 = enabled and THEME.Cyan or THEME.Panel4
			}
		)

		Tween(
			knob,
			0.18,
			{
				Position =
					enabled
						and UDim2.new(1, -24, 0.5, -10)
						or UDim2.new(0, 4, 0.5, -10)
			}
		)

		if settingKey == "Effects" then
			GlowLeft.Visible = enabled
			GlowRight.Visible = enabled
		end

		if settingKey == "Particles" then
			ParticleHolder.Visible = enabled
		end

		Notify(
			"SETTING UPDATED",
			title .. " is now " .. (enabled and "enabled." or "disabled."),
			enabled and THEME.Green or THEME.Orange,
			2
		)
	end)

	return toggle
end

