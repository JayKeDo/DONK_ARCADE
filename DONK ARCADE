	--========================================================
	-- COLLISION
	--========================================================

	local function Intersects(
		position,
		box
	)

		return
			position.X
			<
			box.X
			+
			box.W

			and
			position.X
			+
			PLAYER_SIZE
			>
			box.X

			and
			position.Y
			<
			box.Y
			+
			box.H

			and
			position.Y
			+
			PLAYER_SIZE
			>
			box.Y
	end

	local function ResetStage(
		loseLife
	)

		if loseLife then

			lives -=
				1

			deaths +=
				1

			LivesLabel.Text =
				"LIVES • "
				..
				tostring(
					lives
				)

			if lives <= 0 then

				running =
					false

				ResetButton.Text =
					"PLAY AGAIN"

				Message.Text =
					"RUN OVER\nFinal score: "
					..
					tostring(
						score
					)

				Message.TextColor3 =
					THEME.Red

				return
			end
		end

		ClearLevel()

		gravityDirection =
			Vector2.new(
				0,
				1
			)

		velocity =
			Vector2.zero

		local levelFunction =
			STAGES[
				(
					(stage - 1)
					%
					#STAGES
				)
				+
				1
			]

		levelFunction()

		Player.Position =
			UDim2.fromOffset(
				playerPosition.X,
				playerPosition.Y
			)

		StageLabel.Text =
			"CHAMBER "
			..
			tostring(
				stage
			)

		GravityLabel.Text =
			"GRAVITY ↓"
	end

	local function Die()

		if not running then
			return
		end

		Message.Text =
			"HAZARD HIT • RESTARTING"

		Message.TextColor3 =
			THEME.Red

		ResetStage(
			true
		)
	end

	local function CompleteStage()

		score +=
			500
			+
			math.max(
				0,
				250
				-
				deaths
				*
				20
			)

		stage +=
			1

		ScoreLabel.Text =
			"SCORE • "
			..
			tostring(
				score
			)

		Message.Text =
			"CHAMBER CLEARED"

		Message.TextColor3 =
			THEME.Green

		ResetStage(
			false
		)
	end

	--========================================================
	-- GRAVITY INPUT
	--========================================================

	local function UpdateGravityLabel()

		if gravityDirection.X == 1 then

			GravityLabel.Text =
				"GRAVITY →"

		elseif gravityDirection.X == -1 then

			GravityLabel.Text =
				"GRAVITY ←"

		elseif gravityDirection.Y == 1 then

			GravityLabel.Text =
				"GRAVITY ↓"

		else

			GravityLabel.Text =
				"GRAVITY ↑"
		end
	end

	local function RotateGravity()

		if gravityDirection.X == 0
			and
			gravityDirection.Y == 1 then

			gravityDirection =
				Vector2.new(
					1,
					0
				)

		elseif gravityDirection.X == 1 then

			gravityDirection =
				Vector2.new(
					0,
					-1
				)

		elseif gravityDirection.Y == -1 then

			gravityDirection =
				Vector2.new(
					-1,
					0
				)

		else

			gravityDirection =
				Vector2.new(
					0,
					1
				)
		end

		UpdateGravityLabel()
	end

	local function ReverseGravity()

		gravityDirection =
			-gravityDirection

		UpdateGravityLabel()
	end

	Bag:Add(
		UserInputService.InputBegan:Connect(
			function(
				input,
				processed
			)

				if processed
					or
					not running then

					return
				end

				if input.KeyCode ==
					Enum.KeyCode.A then

					keys.Left =
						true

				elseif input.KeyCode ==
					Enum.KeyCode.D then

					keys.Right =
						true

				elseif input.KeyCode ==
					Enum.KeyCode.W then

					keys.Up =
						true

				elseif input.KeyCode ==
					Enum.KeyCode.S then

					keys.Down =
						true

				elseif input.KeyCode ==
					Enum.KeyCode.Space then

					if UserInputService:IsKeyDown(
						Enum.KeyCode.LeftShift
					)
					or
					UserInputService:IsKeyDown(
						Enum.KeyCode.RightShift
					) then

						ReverseGravity()

					else

						RotateGravity()
					end

				elseif input.KeyCode ==
					Enum.KeyCode.R then

					ResetStage(
						true
					)
				end
			end
		)
	)

	Bag:Add(
		UserInputService.InputEnded:Connect(
			function(input)

				if input.KeyCode ==
					Enum.KeyCode.A then

					keys.Left =
						false

				elseif input.KeyCode ==
					Enum.KeyCode.D then

					keys.Right =
						false

				elseif input.KeyCode ==
					Enum.KeyCode.W then

					keys.Up =
						false

				elseif input.KeyCode ==
					Enum.KeyCode.S then

					keys.Down =
						false
				end
			end
		)
	)

	--========================================================
	-- PHYSICS
	--========================================================

	Bag:Add(
		RunService.RenderStepped:Connect(
			function(dt)

				if not running then
					return
				end

				dt =
					math.min(
						dt,
						0.035
					)

				local inputForce =
					Vector2.zero

				if gravityDirection.Y ~= 0 then

					if keys.Left then

						inputForce +=
							Vector2.new(
								-1,
								0
							)
					end

					if keys.Right then

						inputForce +=
							Vector2.new(
								1,
								0
							)
					end

				else

					if keys.Up then

						inputForce +=
							Vector2.new(
								0,
								-1
							)
					end

					if keys.Down then

						inputForce +=
							Vector2.new(
								0,
								1
							)
					end
				end

				velocity +=
					gravityDirection
					*
					GRAVITY
					*
					dt

				velocity +=
					inputForce
					*
					MOVE_FORCE
					*
					dt

				velocity *=
					math.pow(
						0.985,
						dt
						*
						60
					)

				if velocity.Magnitude >
					MAX_SPEED then

					velocity =
						velocity.Unit
						*
						MAX_SPEED
				end

				local oldPosition =
					playerPosition

				local proposed =
					playerPosition
					+
					velocity
					*
					dt

				proposed =
					Vector2.new(
						math.clamp(
							proposed.X,
							0,
							WORLD_WIDTH
							-
							PLAYER_SIZE
						),

						math.clamp(
							proposed.Y,
							0,
							WORLD_HEIGHT
							-
							PLAYER_SIZE
						)
					)

				local collided =
					false

				for _,platform in ipairs(
					currentPlatforms
				) do

					if Intersects(
						proposed,
						platform
					) then

						collided =
							true

						break
					end
				end

				if collided then

					proposed =
						oldPosition

					velocity =
						velocity
						*
						0.18
				end

				playerPosition =
					proposed

				Player.Position =
					UDim2.fromOffset(
						playerPosition.X,
						playerPosition.Y
					)

				for _,hazard in ipairs(
					currentHazards
				) do

					if Intersects(
						playerPosition,
						hazard
					) then

						Die()

						return
					end
				end

				if currentGoal
					and
					Intersects(
						playerPosition,
						currentGoal
					) then

					CompleteStage()
				end
