	local sliderDragging =
		false

	local function SetCustomSensitivityFromX(
		x
	)

		if sensitivityIndex ~=
			#SENSITIVITIES then

			return
		end

		local absoluteX =
			x
			-
			SliderBack.AbsolutePosition.X

		local width =
			SliderBack.AbsoluteSize.X

		if width <= 0 then
			return
		end

		local percentage =
			math.clamp(
				absoluteX /
				width,
				0,
				1
			)

		-- 50% -> 250%

		customSensitivity =
			math.floor(
				(
					50
					+
					percentage *
					200
				)
				/
				5
				+
				0.5
			)
			*
			5

		local normalized =
			(
				customSensitivity
				-
				50
			)
			/
			200

		SliderFill.Size =
			UDim2.new(
				normalized,
				0,
				1,
				0
			)

		SliderKnob.Position =
			UDim2.new(
				normalized,
				-9,
				0.5,
				-9
			)

		CustomValue.Text =
			tostring(
				customSensitivity
			)
