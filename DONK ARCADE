	local function SpinReel(
		candidates,
		token,
		chosen
	)

		selecting =
			true

		Status.Text =
			IsHard()
			and
			"CHOOSING DANGER COLORS..."
			or
			"CHOOSING DANGER COLOR..."

		if IsHard() then

			SingleColor.Visible =
				false

			SingleColorName.Visible =
				false

			MultiColor.Visible =
				true

		else

			SingleColor.Visible =
				true

			SingleColorName.Visible =
				true

			MultiColor.Visible =
				false
		end

		local start =
			os.clock()

		while
			os.clock() - start
			<
			2 do

			if token ~=
				roundToken then

				selecting =
					false

				return nil
			end

			if IsHard() then

				for index = 1,
					#chosen do

					local candidate =
						candidates[
							math.random(
								1,
								#candidates
							)
						]

					local slot =
						DangerSlots[
							index
						]

					if slot then

						slot.Frame.Visible =
							true

						slot.Dot.BackgroundColor3 =
							candidate.color
							or
							FAMILY_COLORS[
								candidate.family
							]

						slot.Label.Text =
							candidate.family
					end
				end

			else

				local candidate =
					candidates[
						math.random(
							1,
							#candidates
						)
					]

				SetSingleDisplay(
					candidate.family
				)
			end

			task.wait(
				0.075
			)
		end

		if token ~=
			roundToken then

			selecting =
				false

			return nil
		end

		if IsHard() then

			SetMulti(
				chosen
			)

		else

			SetSingleDisplay(
				chosen[1]
			)
		end

		selecting =
			false

		return chosen
	end

	local function StartRound()

		if running
			or
			selecting then

			return
		end

		roundToken += 1

		local token =
			roundToken

		running =
			false

		selecting =
			false

		roundEnd =
			nil

		dangerFamilies =
			{}

		ResetAFK()

		Status.Text =
			"SCANNING MAP..."

		TimerLabel.Text =
			"SCANNING"

		local mode =
			MODES[
				currentModeIndex
			]

		if IsHard() then

			dangerCount =
				HARD_OPTIONS[
					optionIndex
				]

		else

			dangerCount =
				1
		end

		local candidates =
			ScanColorFamilies()

		if token ~=
			roundToken then

			return
		end

		if #candidates == 0 then

			Status.Text =
				"NO VALID COLORS FOUND"

			TimerLabel.Text =
				"ERROR"

			return
		end

		local chosen =
			ChooseTargetFamilies(
				candidates,
				dangerCount
			)

		local selected =
			SpinReel(
				candidates,
				token,
				chosen
			)

		if token ~=
			roundToken then
			return
		end

		if not selected then
			return
		end

		dangerFamilies =
			{}

		for _,family in ipairs(
			selected
		) do

			dangerFamilies[
				family
			] =
				true
		end

		running =
			true

		Status.Text =
			IsHard()
			and
			"AVOID EVERY COLOR ABOVE!"
			or
			"DON'T STEP ON THE COLOR!"

		if mode ==
			"Timed" then

			roundEnd =
				os.clock()
				+
				TIMED_OPTIONS[
					optionIndex
				]

		elseif mode ==
			"Hard" then

			roundEnd =
				os.clock()
				+
				60

		else

			roundEnd =
				nil

			TimerLabel.Text =
				"ENDLESS"
		end

		local root =
			GetRoot()

		if root then

			afkAnchorPosition =
				Vector3.new(
					root.Position.X,
					0,
					root.Position.Z
				)

			afkTimerStart =
				os.clock()
		end
	end

	--========================================================
	-- COLOR PANIC LOOP
	--========================================================

	RunService.Heartbeat:Connect(
		function()

			if not running then
				return
			end

			local now =
				os.clock()

			if now -
				lastDangerCheck
				>=
				TOUCH_INTERVAL then

				lastDangerCheck =
					now

				local character =
					GetCharacter()

				if character then

					local root =
						character:
						FindFirstChild(
							"HumanoidRootPart"
						)

					if root then

						local params =
							OverlapParams.new()

						params.FilterType =
							Enum.RaycastFilterType.Exclude

						params.FilterDescendantsInstances =
							{
								character
							}

						local parts =
							workspace:
							GetPartBoundsInBox(

								CFrame.new(
									root.Position.X,
									root.Position.Y - 3,
									root.Position.Z
								),

								Vector3.new(
									3.5,
									1.2,
									3.5
								),

								params
							)

						for _,part in ipairs(
							parts
						) do

							if part:IsA(
								"BasePart"
							) then

								local family =
									GetColorFamily(
										part.Color
									)

								if dangerFamilies[
									family
								] then

									LoseRound()

									return
								end
							end
						end
					end
				end
			end

			--================================================
			-- ANTI CAMP
			--================================================

			local root =
				GetRoot()

			if not root then

				afkAnchorPosition =
					nil

				afkTimerStart =
					nil

				AFKWarning.Text =
					""

				return
			end

			local current =
				Vector3.new(
					root.Position.X,
					0,
					root.Position.Z
				)

			if not afkAnchorPosition then

				afkAnchorPosition =
					current

				afkTimerStart =
					os.clock()

				return
			end

			local distance =
				(
					current -
					afkAnchorPosition
				).Magnitude

			if distance >=
				AFK_CAMP_RADIUS then

				afkAnchorPosition =
					current

				afkTimerStart =
					os.clock()

				AFKWarning.Text =
					""

				return
			end

			local elapsed =
				os.clock()
				-
				afkTimerStart

			local remaining =
				AFK_LIMIT -
				elapsed

			if elapsed >= 2
				and
				remaining > 0 then

				AFKWarning.Text =
					"⚠ LEAVE THE AREA • AUTO-LOSS IN "
					..
					string.format(
						"%.1f",
						remaining
					)
					..
					" SECONDS"

				AFKWarning.TextColor3 =
					THEME.Yellow

			else

				AFKWarning.Text =
					""
			end

			if remaining <= 0 then

				AFKLoss()
			end
		end
	)

	--========================================================
	-- TIMER
	--========================================================

	RunService.RenderStepped:Connect(
		function()

			if not running then
				return
			end

			if not IsTimed() then
				return
			end

			if not roundEnd then
				return
			end

			local remaining =
				roundEnd -
				os.clock()

			if remaining <= 0 then

				WinRound()

				return
			end

			TimerLabel.Text =
				string.format(
					"%02d",
					math.ceil(
						remaining
					)
				)

			if remaining <= 10 then

				TimerLabel.TextColor3 =
					THEME.Red

			elseif remaining <= 20 then

				TimerLabel.TextColor3 =
					THEME.Orange

			else

				TimerLabel.TextColor3 =
					THEME.Cyan
			end
		end
	)

