	local function SetMulti(
		families
	)

		ClearMulti()

		for index,family in ipairs(
			families
		) do

			local slot =
				DangerSlots[index]

			if slot then

				slot.Frame.Visible =
					true

				slot.Dot.BackgroundColor3 =
					FAMILY_COLORS[
						family
					]

				slot.Label.Text =
					family
			end
