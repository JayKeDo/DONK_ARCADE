			Start.Text =
				"NETWORK ACTIVE"

			ScoreLabel.Text =
				"SCORE • 0"

			UpdateIntegrity()

			Message.TextColor3 =
				THEME.Cyan

			GenerateStage()
		end
	)

	Gui.Size =
		UDim2.fromOffset(
			845,
			610
		)

