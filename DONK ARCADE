	--========================================================
	-- SPIN REEL
	--========================================================

	local function SpinReel(
		candidates,
		token,
		chosenFamilies
	)

		selecting = true

		Status.Text =
			IsHardMode()
			and
			"CHOOSING DANGER COLORS..."
			or
			"CHOOSING DANGER COLOR..."

		AFKWarning.Text = ""

		if IsHardMode() then

			SingleColor.Visible =
				false

			SingleColorName.Visible =
				false

			MultiColor.Visible =
				true

			-- Put every final selected slot
			-- on screen from the beginning.

			for index,family in ipairs(
				chosenFamilies
			) do

				local slot =
					DangerSlots[index]

				if slot then

					slot.Frame.Visible =
						true

					slot.Dot.BackgroundColor3 =
						FAMILY_COLORS[
							family
						]
						or THEME.Panel3

					slot.Label.Text =
						"SELECTING..."
				end
			end

		else

			SingleColor.Visible =
				true

			SingleColorName.Visible =
				true

			MultiColor.Visible =
				false
		end

		local start =
			os.clock()

		local spinDuration =
			2.0

		while
			os.clock() - start
			< spinDuration do

			if token ~=
				roundToken then

				selecting = false

				return nil
			end

			if IsHardMode() then

				for index = 1,
					#chosenFamilies do

					local randomEntry =
						candidates[
							math.random(
								1,
								#candidates
							)
						]

					local slot =
						DangerSlots[index]

					if slot then

						slot.Dot.BackgroundColor3 =
							randomEntry.color
							or
							FAMILY_COLORS[
								randomEntry.family
							]

						slot.Label.Text =
							randomEntry.family
					end
				end

			else

				local randomEntry =
					candidates[
						math.random(
							1,
							#candidates
						)
					]

				SetSingleDisplay(
					randomEntry.family
				)
			end

			task.wait(
				0.075
			)
		end

		if token ~=
			roundToken then

			selecting = false

			return nil
		end

		if IsHardMode() then

			SetMultiDisplay(
				chosenFamilies
			)

		else

			SetSingleDisplay(
				chosenFamilies[1]
			)
		end

		selecting = false

		return chosenFamilies
	end

