	local function GetLevelName(
		level
	)

		local selected =
			"QUIET"

		for i,value in ipairs(
			SOUND_LEVELS
		) do

			if level >= value then

				selected =
					LEVEL_NAMES[i]
			else

				break
			end
		end

		return selected
	end

	local function GetLevelColor(
		level
	)

		if level < 35 then
			return THEME.Green
		end

		if level < 65 then
			return THEME.Orange
		end

		return THEME.Red
	end

	local function UpdateCircleDisplay(
		level
	)

		for _,circle in ipairs(
			SoundCircles
		) do

			local active =
				level >=
				circle.Level

			if active then

				circle.Frame.BackgroundColor3 =
					circle.Color:Lerp(
						Color3.fromRGB(
							255,
							255,
							255
						),
						0.08
					)

			else

				circle.Frame.BackgroundColor3 =
					THEME.Panel2
			end
		end
	end

