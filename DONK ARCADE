--============================================================
-- HUB DRAG
--============================================================

local hubDragging = false
local hubDragStart
local hubStartPosition

Header.InputBegan:Connect(
	function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or
			input.UserInputType ==
			Enum.UserInputType.Touch then

			hubDragging =
				true

			hubDragStart =
				input.Position

			hubStartPosition =
				Hub.Position

			input.Changed:Connect(
				function()

					if input.UserInputState ==
						Enum.UserInputState.End then

						hubDragging =
							false
					end
				end
			)
		end
	end
)

UserInputService.InputChanged:Connect(
	function(input)

		if not hubDragging then
			return
		end

		if input.UserInputType ==
			Enum.UserInputType.MouseMovement
			or
			input.UserInputType ==
			Enum.UserInputType.Touch then

			local delta =
				input.Position -
				hubDragStart

			Hub.Position =
				UDim2.new(

					hubStartPosition.X.Scale,

					hubStartPosition.X.Offset
						+
						delta.X,

					hubStartPosition.Y.Scale,

					hubStartPosition.Y.Offset
						+
						delta.Y
				)
		end
	end
)

--============================================================
-- HUB ANIMATION
--============================================================

task.spawn(
	function()

		while
			ScreenGui
			and
			ScreenGui.Parent do

			local t =
				os.clock()

			local pulse =
				(
					math.sin(
						t *
						0.8
					)
					+
					1
				)
				/
				2

			pcall(function()

				HubGlowA.BackgroundTransparency =
					0.96 -
					pulse *
					0.025

				HubGlowB.BackgroundTransparency =
					0.97 -
					pulse *
					0.02

				HubGradient.Rotation =
					25
					+
					math.sin(
						t *
						0.25
					)
					*
					8
			end)

			for _,data in ipairs(
				HubParticles
			) do

				if data.Object
					and
					data.Object.Parent then

					local x =
						data.X
						+
						math.sin(
							t *
							data.Speed
							+
							data.Phase
						)
						*
						0.012

					local y =
						data.Y
						+
						math.cos(
							t *
							data.Speed
							*
							0.7
							+
							data.Phase
						)
						*
						0.018

					data.Object.Position =
						UDim2.new(
							x,
							0,
							y,
							0
						)
				end
			end

			task.wait(
				0.03
			)
		end
	end
)

