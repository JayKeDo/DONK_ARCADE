	local function UpdateUI()
		local mode = MODES[currentModeIndex]

		ModeLabel.Text = string.upper(mode)

		if mode == "Timed" then
			OptionLabel.Text =
				tostring(TIMED_OPTIONS[optionIndex])
				.. " SECONDS"

			ModeDescription.Text =
				"One danger color is selected. Survive until the timer reaches zero."

			OptionLabel.TextColor3 = THEME.Cyan

		elseif mode == "Endless" then
			OptionLabel.Text = "NO LIMIT"

			ModeDescription.Text =
				"One danger color is selected and the round continues until you lose."

			OptionLabel.TextColor3 = THEME.SubText

		elseif mode == "Hard" then
			OptionLabel.Text =
				tostring(HARD_OPTIONS[optionIndex])
				.. " DANGER COLORS"

			ModeDescription.Text =
				"Multiple colors become dangerous at once. Survive a fixed 60-second round."

			OptionLabel.TextColor3 = THEME.Red

		else
			OptionLabel.Text =
				tostring(HARD_OPTIONS[optionIndex])
				.. " DANGER COLORS"

			ModeDescription.Text =
				"Multiple danger colors stay active with no round timer. Survive as long as possible."

			OptionLabel.TextColor3 = THEME.Red
		end
	end

	local function ResetAFK()
		afkAnchorPosition = nil
		afkTimerStart = nil

		AFKWarning.Text = "Movement monitor standing by."
		AFKWarning.TextColor3 = THEME.SubText
	end

	local function Invalidate()
		roundToken += 1

		running = false
		selecting = false
		roundEnd = nil

		dangerFamilies = {}

		ResetAFK()
		ResetResultStyle()

