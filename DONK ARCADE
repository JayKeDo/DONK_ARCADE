		Header,
		Bag
	)

	task.spawn(
		function()

			while
				Gui
				and
				Gui.Parent
				and
				not returning do

				if Settings.Effects then

					local pulse =
						(
							math.sin(
								os.clock()
								*
								0.8
							)
							+
							1
						)
						/
						2

					Glow.BackgroundTransparency =
						0.98
						-
						pulse
						*
						0.018

				else

					Glow.BackgroundTransparency =
						1
				end

				task.wait(
					0.04
				)
			end
		end
	)

	return {
		Gui = Gui,
		Background = Background,
		Header = Header,
		Title = Title,
		Back = Back,
		Close = Close,
		Bag = Bag,
		Return = Return,

		IsReturning =
			function()
				return returning
			end
	}
end

