	--========================================================
	-- START ROUND
	--========================================================

	local function StartRound()

		if running
			or selecting then

			return
		end

		roundToken += 1

		local thisToken =
			roundToken

		running = false

		selecting = false

		roundEnd = nil

		dangerFamilies = {}

		ResetAFK()

		Status.Text =
			"SCANNING MAP..."

		TimerLabel.Text =
			"SCANNING"

		AFKWarning.Text =
			""

		local mode =
			GetCurrentMode()

		if mode == "Timed"
			or mode == "Endless" then

			dangerCount = 1

		else

			dangerCount =
				HARD_OPTIONS[
					optionIndex
				]
		end

		local candidates =
			ScanColorFamilies()

		if thisToken ~=
			roundToken then

			return
		end

		if #candidates == 0 then

			Status.Text =
				"NO VALID COLORS FOUND"

			TimerLabel.Text =
				"ERROR"

			return
		end

		--====================================================
		-- CHOOSE ALL TARGETS FIRST
		--====================================================

		local chosenFamilies =
			ChooseTargetFamilies(
				candidates,
				dangerCount
			)

		if #chosenFamilies == 0 then

			Status.Text =
				"NO TARGET COLORS FOUND"

			TimerLabel.Text =
				"ERROR"

			return
		end

		local selected =
			SpinReel(
				candidates,
				thisToken,
				chosenFamilies
			)

		if thisToken ~=
			roundToken then

			return
		end

		if not selected then

			Status.Text =
				"ROUND CANCELLED"

			TimerLabel.Text =
				"READY"

			return
		end

		--====================================================
		-- SAVE DANGER FAMILIES
		--====================================================

		dangerFamilies = {}

		for _,family in ipairs(
			selected
		) do

			dangerFamilies[family] =
				true
		end

		--====================================================
		-- ROUND LIVE
		--====================================================

		running = true

		Status.Text =
			IsHardMode()
			and
			"AVOID EVERY COLOR ABOVE!"
			or
			"DON'T STEP ON THE COLOR!"

		if mode == "Timed" then

			roundEnd =
				os.clock()
				+
				TIMED_OPTIONS[
					optionIndex
				]

		elseif mode == "Hard" then

			roundEnd =
				os.clock() + 60

		else

			roundEnd = nil

			TimerLabel.Text =
				"ENDLESS"
		end

		--====================================================
		-- AFK ANCHOR
		--====================================================

		local root =
			GetRoot()

		if root then

			-- Only horizontal coordinates matter.
			-- Vertical movement/jumping cannot fool the detector.

			afkAnchorPosition =
				Vector3.new(
					root.Position.X,
					0,
					root.Position.Z
				)

			afkTimerStart =
				os.clock()

		else

			ResetAFK()
		end
	end

	--========================================================
	-- CHANGE MODE
	--========================================================

	local function ChangeMode(direction)

		if running
			or selecting then

			InvalidateRound()
		end

		currentModeIndex +=
			direction

		if currentModeIndex >
			#MODES then

			currentModeIndex =
				1
		end

		if currentModeIndex <
			1 then

			currentModeIndex =
				#MODES
		end

		local mode =
			GetCurrentMode()

		if mode == "Timed"
			or mode == "Endless" then

			optionIndex =
				math.clamp(
					optionIndex,
					1,
					#TIMED_OPTIONS
				)

		else

			optionIndex =
				math.clamp(
					optionIndex,
					1,
					#HARD_OPTIONS
				)
		end

		UpdateModeUI()

		Status.Text =
			"READY"

		TimerLabel.Text =
			"READY"

		AFKWarning.Text =
			""

		SingleColor.Visible =
			not IsHardMode()

		SingleColorName.Visible =
			not IsHardMode()

		MultiColor.Visible =
			IsHardMode()

		ClearMultiDisplay()
	end

	--========================================================
	-- CHANGE OPTION
	--========================================================

	local function ChangeOption(direction)

		local mode =
			GetCurrentMode()

		if mode == "Endless"
			or mode ==
			"Hard Endless" then

			return
		end

		if running
			or selecting then

			InvalidateRound()
		end

		optionIndex +=
			direction

		if mode == "Timed" then

			if optionIndex >
				#TIMED_OPTIONS then

				optionIndex = 1
			end

			if optionIndex <
				1 then

				optionIndex =
					#TIMED_OPTIONS
			end

		elseif mode == "Hard" then

			if optionIndex >
				#HARD_OPTIONS then

				optionIndex = 1
			end

			if optionIndex <
				1 then

				optionIndex =
					#HARD_OPTIONS
			end
		end

		UpdateModeUI()

		Status.Text =
			"READY"

		TimerLabel.Text =
			"READY"

		AFKWarning.Text =
			""
	end

