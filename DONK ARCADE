			-- Danger check

			if now -
				lastDangerCheck
				>= TOUCH_INTERVAL then

				lastDangerCheck =
					now

				if StandingOnDangerFamily() then

					LoseRound()

					return
				end
			end

			-- Anti-AFK

			UpdateAFK()
		end
	)

	--========================================================
	-- SAFE RESPAWN
	--========================================================

	local playerForRespawn =
		GetLocalPlayer()

	if playerForRespawn then

		playerForRespawn.CharacterAdded:
			Connect(
				function(character)

					task.wait(
						0.35
					)

					if not running then
						return
					end

					local root =
						character:
						FindFirstChild(
							"HumanoidRootPart"
						)

					if root then

						-- Fresh character gets a
						-- fresh AFK anchor.

						afkAnchorPosition =
							Vector3.new(
								root.Position.X,
								0,
								root.Position.Z
							)

						afkTimerStart =
							os.clock()

						AFKWarning.Text =
							""

					else

						ResetAFK()
					end

					Status.Text =
						"ROUND ACTIVE"
				end
			)
	end

	--========================================================
	-- INITIAL UI
	--========================================================

	UpdateModeUI()

	SingleColor.Visible =
		true

	SingleColorName.Visible =
		true

	MultiColor.Visible =
		false

	AFKWarning.Text =
		""

	GameGui.Size =
		UDim2.fromOffset(
			465,
			500
		)

	Tween(
		GameGui,
		0.28,
		{
			Size =
				UDim2.fromOffset(
					500,
					535
				)
		},
		Enum.EasingStyle.Back
	)

	--========================================================
	-- GAME EFFECT ANIMATION
	--========================================================

	task.spawn(
		function()

			while
				GameGui
				and GameGui.Parent do

				local t =
					os.clock()

				local pulse =
					(
						math.sin(
							t * 0.9
						)
						+ 1
					)
					/ 2

				pcall(
					function()

						GameGlow.BackgroundTransparency =
							0.96 -
							pulse * 0.025
					end
				)

				task.wait(
					0.03
				)
			end
		end
	)
end

