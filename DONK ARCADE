	-- CHALLENGE LOGIC
	--========================================================

	local function ChallengeAllowsLevel(
		level
	)

		local challenge =
			CHALLENGES[
				challengeIndex
			]

		if challenge ==
			"KEEP IT DOWN" then

			-- Red begins danger.

			return level < 65

		elseif challenge ==
			"STAY GREEN" then

			-- Green territory only.

			return level < 35

		elseif challenge ==
			"NO RED" then

			-- Red is prohibited.

			return level < 65

		elseif challenge ==
			"NO SPIKES" then

			-- Handled by spike detection.

			return true
		end

		return true
	end

