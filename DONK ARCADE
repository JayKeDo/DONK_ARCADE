	local function UpdateCircleDisplay(
		level
	)

		for _,circle in ipairs(
			SoundCircles
		) do

			local active =
				level >=
				circle.Level

			if active then

				circle.Frame.BackgroundColor3 =
					circle.Color:Lerp(
						Color3.fromRGB(
							255,
							255,
							255
						),
						0.10
					)

			else

				circle.Frame.BackgroundColor3 =
					THEME.Panel2
			end
		end
	end

