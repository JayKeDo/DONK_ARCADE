	--========================================================
	-- START
	--========================================================

	local function StartGame()

		running =
			true

		score =
			0

		combo =
			0

		bestCombo =
			0

		wave =
			1

		survived =
			0

		failures =
			0

		selectedSystem =
			nil

		nextFailure =
			3

		failureInterval =
			5

		gameStart =
			os.clock()

		for _,name in ipairs(
			systemOrder
		) do

			systems[name].Health =
				100

			systems[name].Active =
				false

			systems[name].Severity =
				0

			systems[name].Decay =
				0
		end

		ClearChallenge()

		UpdateSystemButtons()

		ScoreLabel.Text =
			"0"

		WaveLabel.Text =
			"1"

		ComboLabel.Text =
			"x0"

		TimeLabel.Text =
			"00:00"

		Start.Text =
			"ABORT LOCKDOWN"

		Start.BackgroundColor3 =
			THEME.Orange

		WorkTitle.Text =
			"LOCKDOWN ACTIVE"

		WorkTitle.TextColor3 =
			THEME.Red

		WorkSub.Text =
			"Watch all five systems. Failures will become faster and overlap as waves increase."

		task.delay(
			1,
			function()

				if running then
					TriggerFailure()
				end
			end
		)
	end

	Start.MouseButton1Click:Connect(
		function()

			if running then

				EndGame(
					"SIMULATION"
				)

			else

				StartGame()
			end
		end
	)

	--========================================================
	-- MAIN LOOP
	--========================================================

	Bag:Add(
		RunService.Heartbeat:Connect(
			function(dt)

				if not running then
					return
				end

				survived =
					os.clock()
					-
					gameStart

				TimeLabel.Text =
					FormatTime(
						survived
					)

				local newWave =
					1
					+
					math.floor(
						survived
						/
						40
					)

				if newWave
					~=
					wave then

					wave =
						newWave

					WaveLabel.Text =
						tostring(
							wave
						)

					failureInterval =
						math.max(
							1.8,
							5
							-
							wave
							*
							0.28
						)
				end

				if survived >=
					nextFailure then

					TriggerFailure()

					nextFailure =
						survived
						+
						failureInterval
						+
						math.random()
						*
						2
				end

				for _,name in ipairs(
					systemOrder
				) do

					local state =
						systems[name]

					if state.Active then

						state.Health -=
							state.Decay
							*
							dt

						if state.Health <= 0 then

							state.Health =
								0

							UpdateSystemButtons()

							EndGame(
								name
							)

							return
						end
					else

						state.Health =
							math.min(
								100,
								state.Health
								+
								dt
								*
								0.65
							)
					end
				end

				UpdateSystemButtons()

				score +=
					math.floor(
						dt
						*
						4
						*
						wave
					)

				ScoreLabel.Text =
					tostring(
						score
					)
			end
		)
	)

	UpdateSystemButtons()

