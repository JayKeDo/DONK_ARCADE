	--========================================================
	-- COLOR SPINNER
	--========================================================

	local function SpinReel(candidates, token, chosen)
		Status.Text =
			IsHard()
				and "SELECTING COLORS..."
				or "SELECTING COLOR..."

		Status.TextColor3 = THEME.Yellow

		if IsHard() then
			SingleHolder.Visible = false
			MultiHolder.Visible = true
		else
			SingleHolder.Visible = true
			MultiHolder.Visible = false
		end

		local start = os.clock()

		while os.clock() - start < 1.8 do
			if token ~= roundToken or returning then
				return nil
			end

			if IsHard() then
				for index = 1, #chosen do
					local candidate =
						candidates[
							math.random(
								1,
								#candidates
							)
						]

					local slot = DangerSlots[index]

					if slot then
						slot.Frame.Visible = true

						slot.Dot.BackgroundColor3 =
							candidate.color
							or FAMILY_COLORS[candidate.family]

						slot.Label.Text = candidate.family
					end
				end
			else
				local candidate =
					candidates[
						math.random(
							1,
							#candidates
						)
					]

				SetSingleDisplay(candidate.family)
			end

			task.wait(0.075)
		end

		if token ~= roundToken or returning then
			return nil
		end

		if IsHard() then
			SetMulti(chosen)
		else
			SetSingleDisplay(chosen[1])
		end

		return chosen
	end

	--========================================================
	-- START ROUND
	--========================================================

	local function StartRound()
		if running or selecting or returning then
			return
		end

		selecting = true
		roundToken += 1

		local token = roundToken

		ResetResultStyle()
		ResetAFK()

		dangerFamilies = {}
		roundEnd = nil

		Status.Text = "SCANNING MAP..."
		Status.TextColor3 = THEME.Yellow

		TimerLabel.Text = "SCAN"
		TimerLabel.TextColor3 = THEME.Yellow

		StartButton.Text = "SCANNING..."
		StartButton.BackgroundColor3 = THEME.Panel4

		ScanLabel.Text = "Searching nearby physical parts and building color families..."

		task.wait()

		local candidates, scannedParts = ScanColorFamilies()

		if token ~= roundToken or returning then
			selecting = false
			return
		end

		ScanLabel.Text =
			tostring(scannedParts)
			.. " PARTS • "
			.. tostring(#candidates)
			.. " VALID COLOR FAMILIES"

		if #candidates == 0 then
			selecting = false

			Status.Text = "NO VALID COLORS"
			Status.TextColor3 = THEME.Red

			TimerLabel.Text = "ERROR"
			TimerLabel.TextColor3 = THEME.Red

			StartButton.Text = "TRY SCAN AGAIN"
			StartButton.BackgroundColor3 = THEME.Red

			return
		end

		local wantedAmount =
			IsHard()
				and HARD_OPTIONS[optionIndex]
				or 1

		if #candidates < wantedAmount then
			wantedAmount = #candidates

			ScanLabel.Text =
				"Only "
				.. tostring(#candidates)
				.. " valid color families were available, so the round was adjusted."
		end

		local chosen = ChooseTargetFamilies(
			candidates,
			wantedAmount
		)

		local selected = SpinReel(
			candidates,
			token,
			chosen
		)

		if token ~= roundToken or returning or not selected then
			selecting = false
			return
		end

		dangerFamilies = {}

		for _, family in ipairs(selected) do
			dangerFamilies[family] = true
		end

		selecting = false
		running = true

		Status.Text =
			IsHard()
				and "MULTI-COLOR DANGER"
				or "DANGER ACTIVE"

		Status.TextColor3 = THEME.Red

		StartButton.Text = "STOP ROUND"
		StartButton.BackgroundColor3 = THEME.Red

		local mode = MODES[currentModeIndex]

		if mode == "Timed" then
			roundEnd =
				os.clock()
				+ TIMED_OPTIONS[optionIndex]

		elseif mode == "Hard" then
			roundEnd =
				os.clock()
				+ 60

		else
			roundEnd = nil

			TimerLabel.Text = "ENDLESS"
			TimerLabel.TextColor3 = THEME.Cyan
		end

		local root = GetRoot()

		if root then
			afkAnchorPosition = Vector3.new(
				root.Position.X,
				0,
				root.Position.Z
			)

			afkTimerStart = os.clock()
		end

		AFKWarning.Text = "Keep moving."
		AFKWarning.TextColor3 = THEME.Cyan
	end

	--========================================================
	-- DANGER + AFK LOOP
	--========================================================

	Bag:Add(
		RunService.Heartbeat:Connect(function()
			if not running or returning then
				return
			end

			local now = os.clock()

			if now - lastDangerCheck >= TOUCH_INTERVAL then
				lastDangerCheck = now

				local character = GetCharacter()
				local root = GetRoot()

				if character and root then
					local params = OverlapParams.new()

					params.FilterType = Enum.RaycastFilterType.Exclude
					params.FilterDescendantsInstances = {
						character
					}

					local parts = {}

					pcall(function()
						parts = Workspace:GetPartBoundsInBox(
							CFrame.new(
								root.Position.X,
								root.Position.Y - 3,
								root.Position.Z
							),

							Vector3.new(
								3.6,
								1.35,
								3.6
							),

							params
						)
					end)

					for _, part in ipairs(parts) do
						if part:IsA("BasePart") then
							local family =
								GetColorFamily(
									part.Color
								)

							if dangerFamilies[family] then
								LoseRound(
									"You touched the "
									.. family
									.. " color family."
								)

								return
							end
						end
					end
				end
			end

			local root = GetRoot()

			if not root then
				afkAnchorPosition = nil
				afkTimerStart = nil

				AFKWarning.Text =
					"Waiting for your character..."

				AFKWarning.TextColor3 =
					THEME.Yellow

				return
			end

			local current = Vector3.new(
				root.Position.X,
				0,
				root.Position.Z
			)

			if not afkAnchorPosition then
				afkAnchorPosition = current
				afkTimerStart = os.clock()
				return
			end

			local distance =
				(current - afkAnchorPosition).Magnitude

			if distance >= AFK_CAMP_RADIUS then
				afkAnchorPosition = current
				afkTimerStart = os.clock()

				AFKWarning.Text = "Movement accepted."
				AFKWarning.TextColor3 = THEME.Green

				return
			end

			local elapsed =
				os.clock()
				- (afkTimerStart or os.clock())

			local remaining =
				AFK_LIMIT
				- elapsed

			if elapsed >= 2 and remaining > 0 then
				AFKWarning.Text =
					"⚠ LEAVE THIS AREA • AUTO-LOSS IN "
					.. string.format("%.1f", remaining)
					.. "s"

				AFKWarning.TextColor3 = THEME.Yellow

			elseif elapsed < 2 then
				AFKWarning.Text = "Keep moving."
				AFKWarning.TextColor3 = THEME.Cyan
			end

			if remaining <= 0 then
				AFKLoss()
			end
		end)
	)

	--========================================================
	-- TIMER LOOP
	--========================================================

	Bag:Add(
		RunService.RenderStepped:Connect(function()
			if not running or returning then
				return
			end

			if not roundEnd then
				return
			end

			local remaining =
				roundEnd
				- os.clock()

			if remaining <= 0 then
				WinRound()
				return
			end

			TimerLabel.Text =
				string.format(
					"%02d",
					math.ceil(remaining)
				)

			if remaining <= 10 then
				TimerLabel.TextColor3 = THEME.Red

			elseif remaining <= 20 then
				TimerLabel.TextColor3 = THEME.Orange

			else
				TimerLabel.TextColor3 = THEME.Cyan
			end
		end)
	)

