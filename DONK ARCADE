local particles = {}
for i=1,14 do
    local p = Create("Frame", {
        Size = UDim2.fromOffset(math.random(2,4), math.random(2,4)),
        Position = UDim2.fromScale(math.random(),math.random()),
        BackgroundColor3 = (i%3==0 and THEME.Purple) or (i%2==0 and THEME.Cyan) or THEME.Blue,
        BackgroundTransparency = 0.65,
        BorderSizePixel = 0,
        ZIndex = 11
    }, HubBg)
    Corner(p,99)
    particles[i] = {Object=p, Speed=math.random(4,12)/10000, Drift=(math.random()-0.5)/8000}
end

task.spawn(function()
    while ScreenGui.Parent do
        for _,d in ipairs(particles) do
            local p=d.Object
            if p and p.Parent then
                p.Visible = Settings.Particles
                if Settings.Particles then
                    local x=p.Position.X.Scale+d.Drift
                    local y=p.Position.Y.Scale-d.Speed
                    if y < -0.02 then y=1.02; x=math.random() end
                    if x < -0.02 then x=1.02 elseif x>1.02 then x=-0.02 end
                    p.Position=UDim2.fromScale(x,y)
                end
            end
        end
        task.wait(0.03)
    end
end)

