	--========================================================
	-- AUDIO LEVEL
	--========================================================

	local function ReadMicrophoneLevel()

		if not microphoneReady
			or
			not analyzer then

			return 0
		end

		local rms = 0
		local peak = 0

		pcall(function()

			rms =
				tonumber(
					analyzer.RmsLevel
				)
				or
				0

			peak =
				tonumber(
					analyzer.PeakLevel
				)
				or
				0
		end)

		rms =
			math.clamp(
				rms,
				0,
				1
			)

		peak =
			math.clamp(
				peak,
				0,
				1
			)

		local rmsAmplitude =
			math.sqrt(
				rms
			)

		local peakAmplitude =
			math.sqrt(
				peak
			)

		local mixed =
			rmsAmplitude *
			0.78
			+
			peakAmplitude *
			0.22

		local multiplier

		if sensitivityIndex ==
			#SENSITIVITIES then

			multiplier =
				customSensitivity
				/
				100

		else

			multiplier =
				SENSITIVITIES[
					sensitivityIndex
				].Multiplier
		end

		local value =
			mixed
			*
			100
			*
			multiplier

		return math.clamp(
			value,
			0,
			100
		)
	end

