local NavEntries = {
	Games = GamesNav,
	Settings = SettingsNav,
	About = AboutNav
}

local function SetNavActive(name)
	for entryName, data in pairs(NavEntries) do
		local active = entryName == name

		Tween(
			data.Button,
			0.15,
			{
				BackgroundColor3 = active and THEME.Panel3 or THEME.Panel2,
				BackgroundTransparency = active and 0.05 or 0.45
			}
		)

		Tween(
			data.Accent,
			0.15,
			{
				BackgroundTransparency = active and 0 or 1
			}
		)

		data.Icon.TextColor3 = active and THEME.Cyan or THEME.SubText
		data.Label.TextColor3 = active and THEME.Text or THEME.SubText
	end
end

local function SetPage(pageName)
	GamesPage.Visible = pageName == "Games"
	SettingsPage.Visible = pageName == "Settings"
	AboutPage.Visible = pageName == "About"

	SetNavActive(pageName)

	if pageName == "Games" then
		Header.Text = "GAME LIBRARY"
		HeaderSub.Text = "Pick a game and cause some controlled chaos."

	elseif pageName == "Settings" then
		Header.Text = "SETTINGS"
		HeaderSub.Text = "Tune the DONK interface to your preference."

	else
		Header.Text = "ABOUT DONK"
		HeaderSub.Text = "Different mechanics. One arcade."
	end
end

