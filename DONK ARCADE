local function applySearch()
    local q = string.lower(SearchBox.Text or "")
    local visible = 0
    for _,entry in pairs(CardRefs) do
        local d = entry.Data
        local hay = string.lower((d.Name or "").." "..(d.Category or "").." "..(d.Description or ""))
        local show = q == "" or string.find(hay,q,1,true) ~= nil
        entry.Card.Visible = show
        if show and d.Status == "PLAYABLE" then visible += 1 end
    end
    if q == "" then GameCounter.Text = "6 GAMES ONLINE" else GameCounter.Text = tostring(visible).." MATCHING" end
    refreshCanvas()
end
SearchBox:GetPropertyChangedSignal("Text"):Connect(applySearch)

