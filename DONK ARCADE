	--========================================================
	-- COLOR CLASSIFIER
	--========================================================

	local function GetColorFamily(color)

		local h,s,v =
			color:ToHSV()

		if v < 0.16 then
			return "BLACK"
		end

		if s < 0.10
			and v > 0.82 then

			return "WHITE"
		end

		if s < 0.18 then
			return "GRAY"
		end

		if h >= 0.04
			and h <= 0.13
			and v < 0.60 then

			return "BROWN"
		end

		if h < 0.035
			or h >= 0.96 then

			return "RED"
		end

		if h >= 0.035
			and h < 0.10 then

			return "ORANGE"
		end

		if h >= 0.10
			and h < 0.18 then

			return "YELLOW"
		end

		if h >= 0.18
			and h < 0.43 then

			return "GREEN"
		end

		if h >= 0.43
			and h < 0.53 then

			return "CYAN"
		end

		if h >= 0.53
			and h < 0.68 then

			return "BLUE"
		end

		if h >= 0.68
			and h < 0.82 then

			return "PURPLE"
		end

		if h >= 0.82
			and h < 0.96 then

			return "PINK"
		end

		return "GRAY"
	end

	--========================================================
	-- MAP SCAN
	--========================================================

	local function ScanColorFamilies()

		local counts = {}
		local representatives = {}

		local root =
			GetRoot()

		local origin =
			root
			and root.Position
			or Vector3.zero

		for _,obj in ipairs(
			workspace:GetDescendants()
		) do

			if obj:IsA("BasePart") then

				local distance = 0

				pcall(function()

					distance =
						(
							obj.Position -
							origin
						).Magnitude

				end)

				if distance <=
					SCAN_DISTANCE then

					local family =
						GetColorFamily(
							obj.Color
						)

					counts[family] =
						(
							counts[family]
							or 0
						)
						+ 1

					if not representatives[
						family
					] then

						representatives[
							family
						] =
							obj.Color
					end
				end
			end
		end

		local candidates = {}

		for family,count in pairs(
			counts
		) do

			if count >=
				MIN_FAMILY_PARTS then

				table.insert(
					candidates,
					{
						family = family,

						count = count,

						color =
							representatives[
								family
							]
					}
				)
			end
		end

		table.sort(
			candidates,
			function(a,b)

				return a.count >
					b.count

			end
		)

		return candidates
	end

	--========================================================
	-- TARGET SELECTION
	--========================================================

	local function ChooseTargetFamilies(
		candidateList,
		amount
	)

		local result = {}

		local available = {}

		for _,entry in ipairs(
			candidateList
		) do

			table.insert(
				available,
				entry
			)
		end

		while #result < amount
			and #available > 0 do

			local totalWeight = 0

			for _,entry in ipairs(
				available
			) do

				totalWeight +=
					math.clamp(
						entry.count,
						1,
						10000
					)
			end

			local pick =
				math.random() *
				totalWeight

			local chosenIndex = 1

			for i,entry in ipairs(
				available
			) do

				pick -=
					math.clamp(
						entry.count,
						1,
						10000
					)

				if pick <= 0 then

					chosenIndex = i

					break
				end
			end

			local chosen =
				table.remove(
					available,
					chosenIndex
				)

			table.insert(
				result,
				chosen.family
			)
		end

		return result
	end

