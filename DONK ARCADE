--============================================================
-- CONNECTION BAG
--============================================================

local function NewConnectionBag()
	local bag = {
		Connections = {},
		Destroyed = false
	}

	function bag:Add(connection)
		if not connection then
			return connection
		end

		table.insert(self.Connections, connection)

		return connection
	end

	function bag:DisconnectAll()
		if self.Destroyed then
			return
		end

		self.Destroyed = true

		for _, connection in ipairs(self.Connections) do
			pcall(function()
				connection:Disconnect()
			end)
		end

		table.clear(self.Connections)
	end

	return bag
end

--============================================================
-- SAFE DRAG
--============================================================

local function ClampPositionToViewport(frame, position)
	local camera = Workspace.CurrentCamera

	if not camera then
		return position
	end

	local viewport = camera.ViewportSize
	local size = frame.AbsoluteSize
	local anchor = frame.AnchorPoint

	local scaleBaseX = viewport.X * position.X.Scale
	local scaleBaseY = viewport.Y * position.Y.Scale

	local desiredX = scaleBaseX + position.X.Offset
	local desiredY = scaleBaseY + position.Y.Offset

	local minX = size.X * anchor.X + 8
	local maxX = viewport.X - size.X * (1 - anchor.X) - 8

	local minY = size.Y * anchor.Y + 8
	local maxY = viewport.Y - size.Y * (1 - anchor.Y) - 8

	if maxX < minX then
		desiredX = viewport.X / 2
	else
		desiredX = math.clamp(desiredX, minX, maxX)
	end

	if maxY < minY then
		desiredY = viewport.Y / 2
	else
		desiredY = math.clamp(desiredY, minY, maxY)
	end

	return UDim2.new(
		position.X.Scale,
		desiredX - scaleBaseX,

		position.Y.Scale,
		desiredY - scaleBaseY
	)
end

local function MakeDraggable(frame, handle, bag)
	local dragging = false
	local dragStart
	local startPosition

	bag:Add(
		handle.InputBegan:Connect(function(input)
			if
				input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch
			then
				return
			end

			dragging = true
			dragStart = input.Position
			startPosition = frame.Position

			bag:Add(
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			)
		end)
	)

	bag:Add(
		UserInputService.InputChanged:Connect(function(input)
			if not dragging then
				return
			end

			if
				input.UserInputType ~= Enum.UserInputType.MouseMovement
				and input.UserInputType ~= Enum.UserInputType.Touch
			then
				return
			end

			local delta = input.Position - dragStart

			local newPosition = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,

				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)

			frame.Position = ClampPositionToViewport(frame, newPosition)
		end)
	)
end

