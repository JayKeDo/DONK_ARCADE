	gameName
)

	if gameName ==
		"COLOR PANIC!" then

		LaunchColorPanic()

	elseif gameName ==
		"LOWER YOUR TONE" then

		LaunchLowerYourTone()

	elseif gameName ==
		"LOCKDOWN" then

		LaunchLockdown()

	elseif gameName ==
		"GRAVITY SHIFT" then

		LaunchGravityShift()

	elseif gameName ==
		"VECTOR" then

		LaunchVector()

	elseif gameName ==
		"DEAD SIGNAL" then

		LaunchDeadSignal()
	end
end
