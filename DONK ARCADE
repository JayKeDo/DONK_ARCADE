	--========================================================
	-- AUDIO MONITOR
	--========================================================

	RunService.RenderStepped:Connect(
		function()

			local rawLevel =
				ReadMicrophoneLevel()

			-- Smooth microphone level.

			smoothLevel =
				smoothLevel +
				(
					rawLevel -
					smoothLevel
				)
				*
				0.22

			currentLevel =
				math.clamp(
					smoothLevel,
					0,
					100
				)

			LevelNumber.Text =
				tostring(
					math.floor(
						currentLevel
						+
						0.5
					)
				)

			LevelName.Text =
				GetLevelName(
					currentLevel
				)

			local levelColor =
				GetLevelColor(
					currentLevel
				)

			LevelNumber.TextColor3 =
				levelColor

			LevelName.TextColor3 =
				levelColor

			UpdateCircleDisplay(
				currentLevel
			)

			-- Main meter ring reacts to sound.

			local pulse =
				math.clamp(
					0.98
					+
					(
						currentLevel
						/
						100
					)
					*
					0.12,
					0.98,
					1.10
				)

			MeterOuter.Size =
				UDim2.fromOffset(
					225 * pulse,
					225 * pulse
				)

			MeterOuter.Position =
				UDim2.new(
					0.5,
					-112 * pulse,
					0,
					105 -
					(
						112 *
						(
							pulse -
							1
						)
					)
				)

			--================================================
			-- ONLY GAME WHILE ROUND IS RUNNING
			--================================================

			if not running then
				return
			end

			--================================================
			-- HARD THRESHOLD
			--================================================

			local challenge =
				CHALLENGES[
					challengeIndex
				]

			if
				challenge ==
				"KEEP IT DOWN"
				or
				challenge ==
				"NO RED" then

				if currentLevel >= 95 then

					Lose(
						"LEVEL"
					)

					return
				end

				-- Sustained red causes loss.

				if currentLevel >= 65 then

					peakMemory =
						math.max(
							peakMemory,
							currentLevel
						)

					if currentLevel >= 78 then

						Lose(
							"LEVEL"
						)

						return
					end
				end

			elseif challenge ==
				"STAY GREEN" then

				if currentLevel >= 35 then

					Lose(
						"LEVEL"
					)

					return
				end

			elseif challenge ==
				"NO SPIKES" then

				--================================================
				-- SPIKE TRACKING
				--================================================

				if spikeCooldown > 0 then

					spikeCooldown =
						math.max(
							0,
							spikeCooldown
							-
							RunService.Heartbeat:Wait()
						)
				end

				if currentLevel >= 80
					and
					spikeCooldown <= 0 then

					spikeCount += 1

					spikeCooldown =
						0.7

					if spikeCount >= 3 then

						Lose(
							"SPIKE"
						)

						return
					end
				end
			end

			--================================================
			-- TIMER
			--================================================

			if roundEnd then

				local remaining =
					roundEnd -
					os.clock()

				if remaining <= 0 then

					Win()

					return
				end

				Timer.Text =
					string.format(
						"%02d",
						math.ceil(
							remaining
						)
					)

				if remaining <= 10 then

					Timer.TextColor3 =
						THEME.Orange

				else

					Timer.TextColor3 =
						THEME.Text
				end
			end
		end
	)

