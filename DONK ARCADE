--============================================================

local function UpdateSearch()
	local query =
		string.lower(
			SearchBox.Text
		)

	local visiblePlayable = 0

	for card, gameData in pairs(GameCards) do
		local searchable =
			string.lower(
				gameData.Name
				.. " "
				.. gameData.Category
				.. " "
				.. gameData.Description
			)

		local visible =
			query == ""
			or string.find(
				searchable,
				query,
				1,
				true
			) ~= nil

		card.Visible = visible

		if
			visible
			and gameData.Status == "PLAYABLE"
		then
			visiblePlayable += 1
		end
	end

	if query == "" then
		GameCounter.Text = "2 GAMES ONLINE"
	else
		GameCounter.Text =
			tostring(visiblePlayable)
			.. " MATCHING"
	end

	task.defer(RefreshCanvas)
end

SearchBox:GetPropertyChangedSignal(
	"Text"
):Connect(UpdateSearch)

