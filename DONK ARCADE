--============================================================

task.spawn(function()
	while
		ScreenGui
		and ScreenGui.Parent
	do
		local t = os.clock()

		if Settings.Effects then
			local pulse =
				(
					math.sin(t * 0.75)
					+ 1
				)
					/ 2

			GlowLeft.BackgroundTransparency =
				0.975
				- pulse * 0.022

			GlowRight.BackgroundTransparency =
				0.977
				- pulse * 0.02
		else
			GlowLeft.BackgroundTransparency = 1
			GlowRight.BackgroundTransparency = 1
		end

		if Settings.Particles then
			for _, data in ipairs(Particles) do
				if
					data.Object
					and data.Object.Parent
				then
					local x =
						data.X
						+ math.sin(
							t * data.Speed
							+ data.Phase
						)
							* 0.011

					local y =
						data.Y
						+ math.cos(
							t
								* data.Speed
								* 0.72
							+ data.Phase
						)
							* 0.016

					data.Object.Position =
						UDim2.new(
							x,
							0,
							y,
							0
						)
				end
			end
		end

		task.wait(0.035)
	end
end)

