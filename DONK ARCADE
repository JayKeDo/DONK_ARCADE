	local function FindAudioInput()
		local player = GetLocalPlayer()

		if not player then
			return nil
		end

		local found

		pcall(function()
			found =
				player:FindFirstChildWhichIsA(
					"AudioDeviceInput",
					true
				)
		end)

		if found then
			return found
		end

		pcall(function()
			for _, object in ipairs(SoundService:GetChildren()) do
				if object:IsA("AudioDeviceInput") then
					local objectPlayer

					pcall(function()
						objectPlayer = object.Player
					end)

					if
						objectPlayer == nil
						or objectPlayer == player
					then
						found = object
						break
					end
				end
			end
		end)

		return found
	end

	local function CleanupAnalyzer()
		pcall(function()
			if wire then
				wire:Destroy()
			end
		end)

		pcall(function()
			if analyzer then
				analyzer:Destroy()
			end
		end)

		wire = nil
		analyzer = nil
	end

	local function SetupAudioAnalyzer()
		CleanupAnalyzer()

		audioInput = FindAudioInput()

		if not audioInput then
			local player = GetLocalPlayer()

			if player then
				pcall(function()
					local created =
						Instance.new(
							"AudioDeviceInput"
						)

					created.Name =
						"DonkAudioDeviceInput"

					created.Player = player
					created.Parent = SoundService

					audioInput = created
					createdAudioInput = true
				end)
			end
		end

		if not audioInput then
			microphoneReady = false

			MicStatus.Text =
				"● MICROPHONE: NOT AVAILABLE"

			MicStatus.TextColor3 = THEME.Red

			return false
		end

		local success = pcall(function()
			analyzer = Instance.new("AudioAnalyzer")

			analyzer.Name = "DonkLowerToneAnalyzer"
			analyzer.SpectrumEnabled = false
			analyzer.Parent = GameGui

			wire = Instance.new("Wire")

			wire.Name = "DonkLowerToneWire"

			wire.SourceInstance = audioInput
			wire.SourceName = "Output"

			wire.TargetInstance = analyzer
			wire.TargetName = "Input"

			wire.Parent = analyzer
		end)

		if
			not success
			or not analyzer
			or not wire
		then
			CleanupAnalyzer()

			microphoneReady = false

			MicStatus.Text =
				"● MICROPHONE: SETUP FAILED"

			MicStatus.TextColor3 = THEME.Red

			return false
		end

		microphoneReady = true

		MicStatus.Text =
			"● MICROPHONE: READY"

		MicStatus.TextColor3 = THEME.Green

		return true
	end

	--========================================================
	-- AUDIO LEVEL
	--========================================================

	local function ReadMicrophoneLevel()
		if
			not microphoneReady
			or not analyzer
		then
			return 0
		end

		local rms = 0
		local peak = 0

		pcall(function()
			rms =
				tonumber(analyzer.RmsLevel)
				or 0

			peak =
				tonumber(analyzer.PeakLevel)
				or 0
		end)

		rms = math.clamp(rms, 0, 1)
		peak = math.clamp(peak, 0, 1)

		local rmsAmplitude = math.sqrt(rms)
		local peakAmplitude = math.sqrt(peak)

		local mixed =
			rmsAmplitude * 0.78
			+ peakAmplitude * 0.22

		local multiplier

		if sensitivityIndex == #SENSITIVITIES then
			multiplier =
				customSensitivity
				/ 100
		else
			multiplier =
				SENSITIVITIES[
					sensitivityIndex
				].Multiplier
		end

		return math.clamp(
			mixed
				* 100
				* multiplier,

			0,
			100
		)
	end

