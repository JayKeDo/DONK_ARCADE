	-- INTERNAL EFFECT ANIMATION
	--========================================================

	task.spawn(
		function()

			while
				GameGui
				and
				GameGui.Parent do

				local t =
					os.clock()

				local pulse =
					(
						math.sin(
							t *
							0.8
						)
						+
						1
					)
					/
					2

				pcall(function()

					GlowA.BackgroundTransparency =
						0.98 -
						pulse *
						0.02

					GlowB.BackgroundTransparency =
						0.98 -
						pulse *
						0.018

				end)

				task.wait(
					0.035
				)
			end
		end
	)
