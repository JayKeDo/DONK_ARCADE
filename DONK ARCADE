	--========================================================
	-- DRAGGING
	--========================================================

	local dragging = false
	local dragStart
	local startPosition

	Title.InputBegan:Connect(
		function(input)

			if input.UserInputType ==
				Enum.UserInputType.MouseButton1
				or
				input.UserInputType ==
				Enum.UserInputType.Touch then

				dragging = true

				dragStart =
					input.Position

				startPosition =
					GameGui.Position

				input.Changed:Connect(
					function()

						if input.UserInputState ==
							Enum.UserInputState.End then

							dragging = false
						end
					end
				)
			end
		end
	)

	UserInputService.InputChanged:Connect(
		function(input)

			if not dragging then
				return
			end

			if input.UserInputType ==
				Enum.UserInputType.MouseMovement
				or
				input.UserInputType ==
				Enum.UserInputType.Touch then

				local delta =
					input.Position -
					dragStart

				GameGui.Position =
					UDim2.new(

						startPosition.X.Scale,

						startPosition.X.Offset
							+
							delta.X,

						startPosition.Y.Scale,

						startPosition.Y.Offset
							+
							delta.Y
					)
			end
		end
	)

	--========================================================
	-- INITIALIZE
	--========================================================

	UpdateSensitivity()
	UpdateChallenge()

	MicStatus.Text =
		"● MICROPHONE: SEARCHING"

	Timer.Text =
		"READY"

	-- Try immediately.

	SetupAudioAnalyzer()

	GameGui.Size =
		UDim2.fromOffset(
			570,
			575
		)

	Tween(
		GameGui,
		0.3,
		{
			Size =
				UDim2.fromOffset(
					620,
					620
				)
		},
		Enum.EasingStyle.Back
	)

	--========================================================
	-- INTERNAL ANIMATION
	--========================================================

	task.spawn(
		function()

			while
				GameGui
				and
				GameGui.Parent do

				local t =
					os.clock()

				local p =
					(
						math.sin(
							t * 0.7
						)
						+ 1
					)
					/
					2

				pcall(function()

					GlowA.BackgroundTransparency =
						0.975 -
						p * 0.02

					GlowB.BackgroundTransparency =
						0.98 -
						p * 0.018

				end)

				task.wait(
					0.035
				)
			end
		end
	)
end

